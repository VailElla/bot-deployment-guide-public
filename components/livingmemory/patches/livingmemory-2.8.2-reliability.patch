new file mode 100644
index 0000000..d8a273b
--- /dev/null
+++ b/tests/test_transaction_cancel.py
@@ -0,0 +1,79 @@
+import asyncio
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+import aiosqlite
+from astrbot_plugin_livingmemory.core.managers.memory_engine import MemoryEngine
+
+
+
+class TransactionCancellation(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = Path(self.tmp.name) / 'test.sqlite3'
+        self.engine = MemoryEngine.__new__(MemoryEngine)
+        self.engine.db_connection = await aiosqlite.connect(self.path, timeout=2)
+        self.engine._db_write_lock = asyncio.Lock()
+        await self.engine.db_connection.execute('CREATE TABLE t (id INTEGER)')
+        await self.engine.db_connection.commit()
+
+    async def asyncTearDown(self):
+        await self.engine.db_connection.close()
+        self.tmp.cleanup()
+
+    async def test_cancel_queued_begin_releases_write_lock(self):
+        blocker = sqlite3.connect(self.path, timeout=1)
+        blocker.execute('BEGIN IMMEDIATE')
+        entered = asyncio.Event()
+        async def write():
+            async with self.engine._write_transaction() as conn:
+                entered.set()
+                await conn.execute('INSERT INTO t VALUES (1)')
+        task = asyncio.create_task(write())
+        await asyncio.sleep(.15)
+        task.cancel()
+        await asyncio.sleep(.05)
+        task.cancel()
+        blocker.rollback()
+        blocker.close()
+        with self.assertRaises(asyncio.CancelledError):
+            await asyncio.wait_for(task, 3)
+        # aiosqlite's SQLite worker may execute queued BEGIN after cancellation.
+        await asyncio.sleep(.25)
+        self.assertFalse(entered.is_set())
+        self.assertFalse(self.engine.db_connection.in_transaction)
+        other = sqlite3.connect(self.path, timeout=.25)
+        try:
+            other.execute('BEGIN IMMEDIATE')
+            other.execute('INSERT INTO t VALUES (2)')
+            other.commit()
+            self.assertEqual(other.execute('SELECT id FROM t').fetchall(), [(2,)])
+        finally:
+            other.close()
+
+    async def test_cancel_inside_write_rolls_back(self):
+        written, pause = asyncio.Event(), asyncio.Event()
+        async def write():
+            async with self.engine._write_transaction() as conn:
+                await conn.execute('INSERT INTO t VALUES (1)')
+                written.set()
+                await pause.wait()
+        task = asyncio.create_task(write())
+        await written.wait()
+        task.cancel()
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await task
+        self.assertFalse(self.engine.db_connection.in_transaction)
+        other = sqlite3.connect(self.path, timeout=.25)
+        try:
+            other.execute('BEGIN IMMEDIATE')
+            self.assertEqual(other.execute('SELECT count(*) FROM t').fetchone()[0], 0)
+            other.rollback()
+        finally:
+            other.close()
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
