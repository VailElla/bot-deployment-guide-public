+"""Store topic records with independent progress and retry boundaries."""
+from __future__ import annotations
+
+import asyncio
+import copy
+import hashlib
+import json
+
+from ..content_batching import window_tokens
+from astrbot.api import logger
+
+
+def segment_key(session_id, memory_scope, persona_id, revision, messages):
+    # Stable message IDs survive trimming of earlier, already consumed rows.
+    source = [(getattr(m,'id',None),m.timestamp,m.role,getattr(m,'sender_id',None),m.content) for m in messages]
+    # Revisions are process-local and can change on restart/trim. The stable
+    # source identity and actual text, not that counter, define idempotence.
+    return hashlib.sha256(json.dumps([session_id,memory_scope,persona_id,source],ensure_ascii=False,sort_keys=True).encode()).hexdigest()
+
+
+class PreparedProcessor:
+    def __init__(self, original, result):
+        self.original, self.result = original, result
+
+    def __getattr__(self, key):
+        return getattr(self.original, key)
+
+    async def process_conversation(self, *args, **kwargs):
+        return self.result['content'],dict(self.result['metadata']),self.result['importance']
+
+
+async def commit_topic_progress(reflection, session_id, end_index, expected_revision):
+    task = asyncio.create_task(reflection.conversation_manager.commit_summary_progress(session_id,end_index,expected_revision))
+    try:
+        return await asyncio.shield(task)
+    except asyncio.CancelledError:
+        # Once a durable record and its cursor have both committed, cancellation
+        # must not delete the record while leaving the cursor advanced.
+        if await task:
+            return True
+        raise
+
+
+async def store_topic_window(reflection, session_id, messages, persona_id, start_index, end_index,
+                             retry_count, memory_scope, expected_revision, triggered_by):
+    cm = reflection.conversation_manager
+    cm = getattr(cm, "manager", cm)  # GroupConversationView must pin the shared manager.
+    # Pin coordinates across generation and ALL segment commits. Trimming a
+    # committed prefix between pieces otherwise makes later cursors skip rows.
+    async with cm._session_lock(session_id):
+        live = await cm.get_messages_range(session_id, start_index, end_index)
+        captured = [getattr(m, 'id', None) for m in messages]
+        if not captured or any(i is None for i in captured) or captured != [getattr(m, 'id', None) for m in live]:
+            return False
+        pins = getattr(cm, '_summary_pins', None)
+        if pins is None:
+            pins = cm._summary_pins = {}
+        pins[session_id] = pins.get(session_id, 0) + 1
+    try:
+        return await _store_topic_window(reflection, session_id, messages, persona_id, start_index, end_index,
+                                        retry_count, memory_scope, expected_revision, triggered_by)
+    finally:
+        async with cm._session_lock(session_id):
+            pins[session_id] -= 1
+            if pins[session_id] == 0:
+                pins.pop(session_id)
+
+
+async def _store_topic_window(reflection, session_id, messages, persona_id, start_index, end_index,
+                              retry_count, memory_scope, expected_revision, triggered_by):
+    if not messages or len(messages) != end_index-start_index:
+        return False
+    if reflection.memory_engine is None or reflection.memory_processor is None:
+        await reflection._record_pending_summary(session_id,start_index,end_index,retry_count,expected_revision)
+        return False
+    if expected_revision is None:
+        expected_revision = await reflection._read_session_revision(session_id)
+    if not await reflection._revision_still_valid(session_id,expected_revision):
+        return False
+    current = int(await reflection.conversation_manager.get_session_metadata(session_id,'last_summarized_index',0) or 0)
+    if current >= end_index:
+        return True
+    if current != start_index:
+        return False
+    try:
+        results = await reflection.memory_processor.process_topic_batch(messages=messages,
+            is_group_chat=bool(messages[0].group_id),persona_id=persona_id,
+            max_topics=reflection.config_manager.get('background_summary.topic_max_memories',24))
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        logger.warning("Topic batch deferred/failed: type=%s", type(exc).__name__)
+        await reflection._record_pending_summary(session_id,start_index,end_index,retry_count,expected_revision,failure=exc)
+        return False
+    batch_key = segment_key(session_id,memory_scope,persona_id,expected_revision,messages)
+    for result in results:
+        if reflection._shutting_down or not await reflection._revision_still_valid(session_id,expected_revision):
+            return False
+        local_start,local_end = start_index+result['start'],start_index+result['end']
+        source = messages[result['start']:result['end']]
+        metadata = dict(result['metadata'],topic_batch_key=batch_key,
+            topic_segment_key=segment_key(session_id,memory_scope,persona_id,expected_revision,source),
+            topic_read_window={'start_index':start_index,'end_index':end_index,
+                               'estimated_input_tokens':window_tokens(messages)})
+        piece = copy.copy(reflection)
+        piece.memory_processor = PreparedProcessor(reflection.memory_processor,dict(result,metadata=metadata))
+        ok = await piece._storage_task(session_id,source,persona_id,local_start,local_end,retry_count,
+            memory_scope=memory_scope,expected_revision=expected_revision,triggered_by=triggered_by,_topic_piece=True)
+        if not ok:
+            return False
+        retry_count = 0
+        if asyncio.current_task().cancelling():
+            raise asyncio.CancelledError
+    return True
