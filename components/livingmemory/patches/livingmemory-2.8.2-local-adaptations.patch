+"""Date-bound group evidence for questions about today's group activity."""
+
+import asyncio
+import re
+import time
+from datetime import datetime, timedelta, timezone
+
+from astrbot.api.platform import MessageType
+
+
+_TODAY_GROUP = re.compile(r"(?:今天|今日|今儿|本日).{0,35}(?:群里|群聊|群消息|群中|群内)|(?:群里|群聊|群消息|群中|群内).{0,35}(?:今天|今日|今儿|本日)")
+_TAIPEI = timezone(timedelta(hours=8))
+_MAX_MESSAGES = 1200
+_MAX_CHARS = 160000
+_GROUP_ID = re.compile(r"(?<!\d)\d{5,12}(?!\d)")
+
+
+def _payload(result):
+    if isinstance(result, dict) and 'status' in result:
+        if result.get('status') != 'ok' or result.get('retcode', 0) != 0:
+            raise ValueError('OneBot action failed')
+        return result.get('data')
+    return result
+
+
+async def _private_groups(event, query):
+    """Resolve every current shared group from the platform, not message history."""
+    sender = str(event.get_sender_id() or '')
+    bot = getattr(event, 'bot', None)
+    call = getattr(bot, 'call_action', None)
+    if not sender.isdigit() or not callable(call):
+        return [], '无法核验当前群列表或提问者身份。'
+    self_id = str(getattr(getattr(event, 'message_obj', None), 'self_id', '') or '')
+    routing = {'self_id': self_id} if self_id else {}
+    try:
+        listing = _payload(await asyncio.wait_for(call('get_group_list', **routing), timeout=10))
+    except (Exception, asyncio.CancelledError) as exc:
+        if isinstance(exc, asyncio.CancelledError):
+            raise
+        return [], '群列表暂时不可用。'
+    if not isinstance(listing, list):
+        return [], '群列表格式异常。'
+    listed = {}
+    for item in listing:
+        if not isinstance(item, dict):
+            continue
+        gid = str(item.get('group_id') or '')
+        if gid.isdigit():
+            listed[gid] = str(item.get('group_name') or '')[:60]
+    explicit = set(_GROUP_ID.findall(query or '')) & set(listed)
+    candidates = {gid: listed[gid] for gid in (explicit or listed.keys())}
+    semaphore = asyncio.Semaphore(6)
+
+    async def check(gid, name):
+        async with semaphore:
+            try:
+                data = _payload(await asyncio.wait_for(call(
+                    'get_group_member_info', group_id=int(gid), user_id=int(sender),
+                    no_cache=True, **routing), timeout=10))
+                if isinstance(data, dict) and str(data.get('user_id') or '') == sender:
+                    returned_gid = data.get('group_id')
+                    if returned_gid is None or str(returned_gid) == gid:
+                        return gid, name, True
+                return gid, name, False
+            except (Exception, asyncio.CancelledError) as exc:
+                if isinstance(exc, asyncio.CancelledError):
+                    raise
+                return gid, name, None
+
+    checked = await asyncio.gather(*(check(gid, name) for gid, name in candidates.items()))
+    verified = [(gid, name) for gid, name, member in checked if member is True]
+    failed = sum(member is None for _, _, member in checked)
+    note = f'另有 {failed} 个群的成员身份核验失败，结果可能不全。' if failed else ''
+    if explicit and not verified:
+        note += '指定群无法核验当前成员身份。'
+    return verified, note
+
+
+async def get_daily_group_evidence(store, event, query: str, enabled: bool) -> str | None:
+    """Return timestamped originals from the current group or verified shared groups."""
+    if not enabled or not _TODAY_GROUP.search(query or ""):
+        return None
+    connection = getattr(store, "connection", None)
+    if connection is None:
+        return "今日群聊原始证据：记录暂时不可用；不要把旧记忆说成今天发生的事。"
+    now = time.time()
+    today = datetime.fromtimestamp(now, _TAIPEI).date()
+    start = datetime(today.year, today.month, today.day, tzinfo=_TAIPEI).timestamp()
+    if event.get_message_type() == MessageType.GROUP_MESSAGE:
+        groups = [(str(event.unified_msg_origin), '')]
+        note = ''
+    else:
+        verified, note = await _private_groups(event, query)
+        platform = str(event.get_platform_name())
+        groups = [(f'{platform}:GroupMessage:{gid}', name) for gid, name in verified]
+    if not groups:
+        return '今日群聊原始证据：没有可核验的共同群。' + note + '旧记忆不能证明今天的群聊情况。'
+
+    per_group_messages = max(1, _MAX_MESSAGES // len(groups))
+    per_group_chars = max(1000, _MAX_CHARS // len(groups))
+    sections = []
+    for sid, name in groups:
+        async with connection.execute(
+            """SELECT role,sender_name,timestamp,content FROM messages
+               WHERE session_id=? AND timestamp>=? AND timestamp<=?
+               ORDER BY timestamp DESC,id DESC LIMIT ?""",
+            (sid, start, now, per_group_messages + 1),
+        ) as cursor:
+            rows = await cursor.fetchall()
+        capped = len(rows) > per_group_messages
+        rows = rows[:per_group_messages]
+        lines = []
+        length = 0
+        for role, sender, stamp, content in reversed(rows):
+            clock = datetime.fromtimestamp(float(stamp), _TAIPEI).strftime('%H:%M:%S')
+            line = f"[{clock}] {sender or role} ({role}): {str(content or '')[:1200].replace(chr(10), ' ')}"
+            if length + len(line) > per_group_chars:
+                capped = True
+                continue
+            lines.append(line)
+            length += len(line) + 1
+        coverage = '完整已存记录' if not capped else '部分已存记录（容量截断；不得声称完整）'
+        label = sid + (f' {name}' if name else '')
+        sections.append(f'群 {label}：{coverage}，以下 {len(lines)} 条。' + ('\n' + '\n'.join(lines) if lines else ' 当天无已存原文。'))
+    return (
+        f"今日群聊原始证据：台北时间 {today.isoformat()}，截至 {datetime.fromtimestamp(now, _TAIPEI).strftime('%H:%M:%S')}，"
+        f"已核验 {len(groups)} 个群。{note}仅用带今天时间戳的记录回答今天发生的事；"
+        '长期记忆中的创建时间不是事件时间，未核验日期的旧片段不能作为今天的证据。\n'
+        + '\n'.join(sections)
+    )
