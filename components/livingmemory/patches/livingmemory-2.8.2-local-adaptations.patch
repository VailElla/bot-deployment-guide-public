+"""Two event-bound memory layers; no caller may choose another user's/group's ID."""
+from __future__ import annotations
+
+import asyncio
+import copy
+from typing import Any
+
+from astrbot.api import logger
+from astrbot.api.platform import MessageType
+
+from .memory_scope import resolve_memory_scope, _config_get, is_event_memory_allowed
+
+
+def group_memory_enabled(config: Any) -> bool:
+    return (_config_get(config, 'group_memory.enabled', False) is True
+            and _config_get(config, 'filtering_settings.memory_scope_mode', 'legacy') == 'user')
+
+
+def group_scope(config: Any, event: Any) -> str | None:
+    if not group_memory_enabled(config):
+        return None
+    method = getattr(event, 'get_message_type', None)
+    if not callable(method) or method() != MessageType.GROUP_MESSAGE:
+        return None
+    origin = str(getattr(event, 'unified_msg_origin', '') or '').strip()
+    return origin or None
+
+
+def event_scopes(config: Any, event: Any, scope: str = 'both') -> list[tuple[str, str]]:
+    if scope not in {'user', 'group', 'both'}:
+        raise ValueError('scope must be user, group, or both')
+    personal = resolve_memory_scope(config, event) or event.unified_msg_origin
+    group = group_scope(config, event)
+    if scope == 'group':
+        if group is None:
+            raise ValueError('group memory requires an enabled current group event')
+        return [('group', group)]
+    pairs = [('user', personal)]
+    if scope == 'both' and group and group != personal:
+        pairs.append(('group', group))
+    return pairs
+
+
+async def search_event_memories(engine: Any, config: Any, event: Any, *, query: str,
+                                k: int, persona_id: str | None = None,
+                                scope: str = 'both') -> list:
+    pairs = event_scopes(config, event, scope)
+    if group_memory_enabled(config) and not is_event_memory_allowed(config, event):
+        return []
+    if k <= 0:
+        return []
+    # Preserve upstream result objects and behavior when the optional layer is off.
+    if not group_memory_enabled(config) and scope != 'group':
+        return await engine.search_memories(query=query, k=k, session_id=pairs[0][1], persona_id=persona_id)
+    batches = await asyncio.gather(*[
+        engine.search_memories(query=query, k=k, session_id=sid, persona_id=persona_id)
+        for _, sid in pairs
+    ], return_exceptions=True)
+    layers = []
+    errors = []
+    for (layer, sid), batch in zip(pairs, batches):
+        if isinstance(batch, BaseException):
+            if isinstance(batch, asyncio.CancelledError):
+                raise batch
+            errors.append(batch)
+            logger.warning('LivingMemory %s recall failed: %s', layer, type(batch).__name__)
+            continue
+        selected = []
+        for item in batch:
+            metadata = getattr(item, 'metadata', {})
+            # Check the native scope filter again before any content reaches a request.
+            if not isinstance(metadata, dict) or metadata.get('session_id') != sid:
+                continue
+            result = copy.copy(item)
+            result.metadata = dict(metadata, memory_layer=layer)
+            label = '个人记忆' if layer == 'user' else '本群记忆'
+            result.content = f'[{label}] {item.content}'
+            selected.append(result)
+        layers.append(sorted(selected, key=lambda r: r.final_score, reverse=True))
+    if errors and len(errors) == len(pairs):
+        raise errors[0]
+    # Keep the best item from each available layer, then fill by native relevance.
+    heads = [items[0] for items in layers if items]
+    all_items = sorted([r for items in layers for r in items], key=lambda r: r.final_score, reverse=True)
+    chosen = sorted(heads, key=lambda r: r.final_score, reverse=True)[:k] if k >= len(heads) else all_items[:k]
+    seen = {r.doc_id for r in chosen}
+    for item in all_items:
+        if len(chosen) >= k:
+            break
+        if item.doc_id not in seen:
+            chosen.append(item);seen.add(item.doc_id)
+    return chosen
