+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+import aiosqlite
+import pytest
+
+from astrbot.api.platform import MessageType
+from astrbot_plugin_livingmemory.core.event_handler_modules import daily_group_evidence as evidence
+
+
+NOW = datetime(2026, 11, 1, 13, 32, tzinfo=timezone(timedelta(hours=8))).timestamp()
+
+
+class Bot:
+    def __init__(self, members):
+        self.members = members
+        self.calls = []
+
+    async def call_action(self, action, **params):
+        self.calls.append((action, params))
+        if action == 'get_group_list':
+            return [{'group_id': int(gid), 'group_name': f'群{gid}'} for gid in self.members]
+        if action == 'get_group_member_info':
+            gid = str(params['group_id'])
+            if self.members[gid]:
+                return {'group_id': int(gid), 'user_id': params['user_id']}
+            raise RuntimeError('not a member')
+        raise AssertionError(action)
+
+
+class Event:
+    unified_msg_origin = 'qq:GroupMessage:111111'
+
+    def __init__(self, group=False, members=None):
+        self.group = group
+        self.bot = Bot(members or {})
+        self.message_obj = SimpleNamespace(self_id='987654')
+
+    def get_message_type(self):
+        return MessageType.GROUP_MESSAGE if self.group else MessageType.FRIEND_MESSAGE
+
+    def get_platform_name(self):
+        return 'qq'
+
+    def get_sender_id(self):
+        return '123456'
+
+
+@pytest.fixture
+def fixed_time(monkeypatch):
+    monkeypatch.setattr(evidence.time, 'time', lambda: NOW)
+
+
+@pytest.mark.asyncio
+async def test_private_reads_all_verified_groups_even_without_today_speech(tmp_path, fixed_time):
+    async with aiosqlite.connect(tmp_path / 'm.db') as db:
+        await db.execute('CREATE TABLE messages (id INTEGER PRIMARY KEY,session_id TEXT,role TEXT,sender_name TEXT,timestamp REAL,content TEXT)')
+        await db.executemany('INSERT INTO messages(session_id,role,sender_name,timestamp,content) VALUES(?,?,?,?,?)', [
+            ('qq:GroupMessage:111111', 'user', '友人', NOW - 20, '一群今天的事'),
+            ('qq:GroupMessage:222222', 'user', '友人', NOW - 10, '二群今天的事'),
+            ('qq:GroupMessage:333333', 'user', '友人', NOW - 5, '无成员资格的群'),
+            ('qq:GroupMessage:111111', 'user', '友人', NOW - 86400 * 5, '旧消息不能冒充今天'),
+        ])
+        await db.commit()
+        event = Event(members={'111111': True, '222222': True, '333333': False})
+        result = await evidence.get_daily_group_evidence(SimpleNamespace(connection=db), event, '今天群里发生了什么', True)
+        assert '已核验 2 个群' in result
+        assert '一群今天的事' in result and '二群今天的事' in result
+        assert '无成员资格的群' not in result and '旧消息不能冒充今天' not in result
+        assert any(a == 'get_group_list' and p['self_id'] == '987654' for a, p in event.bot.calls)
+
+        explicit = await evidence.get_daily_group_evidence(SimpleNamespace(connection=db), event, '今天222222群里有什么', True)
+        assert '二群今天的事' in explicit and '一群今天的事' not in explicit
+
+
+@pytest.mark.asyncio
+async def test_group_event_keeps_current_group_only(tmp_path, fixed_time):
+    async with aiosqlite.connect(tmp_path / 'm.db') as db:
+        await db.execute('CREATE TABLE messages (id INTEGER PRIMARY KEY,session_id TEXT,role TEXT,sender_name TEXT,timestamp REAL,content TEXT)')
+        await db.executemany('INSERT INTO messages(session_id,role,sender_name,timestamp,content) VALUES(?,?,?,?,?)', [
+            ('qq:GroupMessage:111111', 'user', 'synthetic-user', NOW - 2, '本群今天'),
+            ('qq:GroupMessage:222222', 'user', 'synthetic-user', NOW - 1, '隔壁群今天'),
+        ])
+        await db.commit()
+        event = Event(group=True)
+        result = await evidence.get_daily_group_evidence(SimpleNamespace(connection=db), event, '今天群里有什么事', True)
+        assert '本群今天' in result and '隔壁群今天' not in result
+        assert event.bot.calls == []
+        assert await evidence.get_daily_group_evidence(SimpleNamespace(connection=db), event, '聊别的', True) is None
