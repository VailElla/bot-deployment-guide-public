+@pytest_asyncio.fixture
+async def system(tmp_path):
+    cfg=ConfigManager({'filtering_settings':{'memory_scope_mode':'user','use_persona_filtering':False},
+      'group_memory':{'enabled':True},'background_summary':{'enabled':True},'memory_dedup':{'enabled':False}})
+    store=ConversationStore(str(tmp_path/'background.db'));await store.initialize()
+    cm=ConversationManager(store,memory_scope_config=cfg);engine=Engine();processor=Mock()
+    async def summarize(messages,**kwargs):return ' | '.join(m.content for m in messages),{'topics':['test']},0.7
+    processor.process_conversation=AsyncMock(side_effect=summarize)
+    processor.classify_atoms_from_metadata=Mock(return_value=[])
+    h=EventHandler(Mock(),cfg,engine,processor,cm,data_dir=str(tmp_path))
+    yield cfg,cm,engine,processor,h,h.background_summary
+    await h.shutdown();await store.close()
+
+async def seed(h,user='a',n=10,group='one'):
+    event=None
+    for i in range(n):
+        event=Event(user,group,text=f'{user} preference fact {i}')
+        event.message_obj.timestamp=time.time()
