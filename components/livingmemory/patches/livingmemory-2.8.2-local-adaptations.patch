index 0000000..d56402e
--- /dev/null
+++ b/tests/test_rolling_summary.py
@@ -0,0 +1,96 @@
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import pytest
+from astrbot_plugin_livingmemory.core.background_summary import BackgroundSummary
+
+
+def scheduler(n=8, hourly=0):
+    settings={'enabled':True,'adaptive':True,'max_sessions_per_run':4,'max_summaries_per_hour':hourly}
+    config=SimpleNamespace(get=lambda key,default=None:settings.get(key.split('.')[-1],default))
+    processor=SimpleNamespace(rate_limit_delay=lambda:0)
+    bg=BackgroundSummary(SimpleNamespace(config_manager=config,memory_processor=processor,_shutting_down=False))
+    bg.candidates=AsyncMock(return_value=[(0,0,0,str(i)) for i in range(n)])
+    return bg
+
+@pytest.mark.asyncio
+async def test_refills_before_slowest_finishes_and_bounds_workers():
+    bg=scheduler();started=[];active=set();peak=0;release=asyncio.Event();fifth=asyncio.Event()
+    async def submit(sid):
+        nonlocal peak
+        started.append(sid);active.add(sid);peak=max(peak,len(active))
+        bg.metrics['admitted_this_pass']+=1
+        try:
+            if sid=='0':await release.wait()
+            else:await asyncio.sleep(0)
+            if sid=='4':fifth.set()
+        finally:active.remove(sid)
+    bg.submit_one=submit
+    task=asyncio.create_task(bg.run_once(rolling=True))
+    try:
+        await asyncio.wait_for(fifth.wait(),2)
+        assert '0' in active and not release.is_set()
+        assert peak<=4
+    finally:release.set();await asyncio.wait_for(task,2)
+    assert len(started)==8 and len(set(started))==8 and not active
+
+@pytest.mark.asyncio
+async def test_cooldown_blocks_refill_but_drains_existing():
+    bg=scheduler();started=[];finished=[];limited=False
+    bg.owner.memory_processor.rate_limit_delay=lambda:60 if limited else 0
+    async def submit(sid):
+        nonlocal limited
+        started.append(sid);bg.metrics['admitted_this_pass']+=1
+        await asyncio.sleep(0)
+        if sid=='0':limited=True
+        finished.append(sid)
+    bg.submit_one=submit
+    await bg.run_once(rolling=True)
+    assert started==['0','1','2','3'] and len(finished)==4
+
+@pytest.mark.asyncio
+async def test_hourly_budget_is_not_exceeded():
+    bg=scheduler(hourly=5);started=[]
+    async def submit(sid):
+        started.append(sid);bg.admissions.append(__import__('time').time())
+        bg.metrics['admitted_this_pass']+=1
+        await asyncio.sleep(0)
+    bg.submit_one=submit
+    await bg.run_once(rolling=True)
+    assert len(started)==5
+
+@pytest.mark.asyncio
+async def test_cancel_settles_all_worker_wrappers():
+    bg=scheduler();active=set();ready=asyncio.Event()
+    async def submit(sid):
+        active.add(sid)
+        if len(active)==4:ready.set()
+        try:await asyncio.Event().wait()
+        finally:active.remove(sid)
+    bg.submit_one=submit
+    task=asyncio.create_task(bg.run_once(rolling=True))
+    await asyncio.wait_for(ready.wait(),2);task.cancel()
+    with pytest.raises(asyncio.CancelledError):await task
+    assert not active and not bg.lock.locked()
+
+@pytest.mark.asyncio
+async def test_worker_error_settles_peers():
+    bg=scheduler();active=set()
+    async def submit(sid):
+        active.add(sid)
+        try:
+            if sid=='0':raise RuntimeError('source error')
+            await asyncio.Event().wait()
+        finally:active.remove(sid)
+    bg.submit_one=submit
+    with pytest.raises(RuntimeError,match='source error'):await bg.run_once(rolling=True)
+    assert not active and not bg.lock.locked()
+
+@pytest.mark.asyncio
+async def test_manual_pass_remains_bounded():
+    bg=scheduler();started=[]
+    async def submit(sid):
+        started.append(sid);bg.metrics['admitted_this_pass']+=1
+    bg.submit_one=submit
+    await bg.run_once()
+    assert len(started)==4
