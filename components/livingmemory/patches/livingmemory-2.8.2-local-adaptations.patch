new file mode 100644
index 0000000..f17a6c3
--- /dev/null
+++ b/core/sqlite_safety.py
@@ -0,0 +1,102 @@
+"""Instance-scoped SQLite concurrency and read cancellation protection."""
+
+from __future__ import annotations
+
+import asyncio
+import functools
+import sqlite3
+from contextlib import closing
+from pathlib import Path
+
+from sqlalchemy import event
+
+
+async def finish_on_cancel(awaitable):
+    """Finish an operation before propagating caller cancellation.
+
+    Args:
+        awaitable: Operation that owns resources requiring orderly cleanup.
+
+    Returns:
+        The operation result when the caller was not cancelled.
+
+    Raises:
+        asyncio.CancelledError: After the operation releases its resources.
+    """
+    task = asyncio.ensure_future(awaitable)
+    cancelled = False
+    while True:
+        try:
+            result = await asyncio.shield(task)
+            break
+        except asyncio.CancelledError:
+            cancelled = True
+            if task.done():
+                # Retrieve any failure without hiding cancellation.
+                if not task.cancelled():
+                    task.exception()
+                raise
+        except BaseException:
+            if cancelled:
+                raise asyncio.CancelledError from None
+            raise
+    if cancelled:
+        raise asyncio.CancelledError
+    return result
+
+
+async def install_sqlite_safety(storage):
+    """Configure one unopened document store and protect its read operations.
+
+    Args:
+        storage: AstrBot DocumentStorage instance, before initialize().
+
+    Raises:
+        RuntimeError: If WAL cannot be enabled or the engine is already open.
+    """
+    if getattr(storage, "_livingmemory_sqlite_safety", False):
+        return
+    if storage.engine is not None:
+        raise RuntimeError("SQLite safety must be installed before connecting")
+
+    def configure_file():
+        path = Path(storage.db_path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with closing(sqlite3.connect(path, timeout=10)) as conn:
+            mode = conn.execute("PRAGMA journal_mode=WAL").fetchone()[0]
+            if mode.lower() != "wal":
+                raise RuntimeError("Document store did not enter WAL mode")
+
+    await asyncio.to_thread(configure_file)
+    await storage.connect()
+
+    @event.listens_for(storage.engine.sync_engine, "connect")
+    def configure_connection(connection, _record):
+        cursor = connection.cursor()
+        try:
+            cursor.execute("PRAGMA busy_timeout=10000")
+        finally:
+            cursor.close()
+
+    # Protect only reads: completing a cancelled SQL write alone could orphan
+    # its row before FaissVecDB receives the returned ID and writes its vector.
+    for name in (
+        "get_documents",
+        "get_document_by_doc_id",
+        "count_documents",
+        "get_user_ids",
+        "search_sparse",
+    ):
+        original = getattr(storage, name, None)
+        if original is None:
+            continue
+
+        def wrap(method):
+            @functools.wraps(method)
+            async def protected(*args, **kwargs):
+                return await finish_on_cancel(method(*args, **kwargs))
+
+            return protected
+
+        setattr(storage, name, wrap(original))
+    storage._livingmemory_sqlite_safety = True
