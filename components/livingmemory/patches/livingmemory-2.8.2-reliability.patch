--- /dev/null
+++ b/tests/test_single_pending_retry.py
@@ -0,0 +1,108 @@
+"""Regression tests for one-message summary retries and document lock recovery."""
+import asyncio
+import sqlite3
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.exc import OperationalError
+from astrbot.core.db.vec_db.faiss_impl.document_storage import DocumentStorage
+from astrbot_plugin_livingmemory.core.sqlite_safety import (
+    _locked_document_insert, install_document_insert_retry, install_sqlite_safety,
+)
+from astrbot_plugin_livingmemory.core.memory_scope import resolve_capture_session
+from astrbot_plugin_livingmemory.storage.conversation_store import ConversationStore
+from tests.test_background_summary import system, seed  # noqa: F401
+
+
+@pytest.mark.asyncio
+async def test_single_content_batch_failure_keeps_retry_state_and_backoff(system):
+    cfg,cm,engine,processor,handler,bg=system
+    cfg._config['background_summary']['content_batching']=True
+    event=await seed(handler,n=1);sid=resolve_capture_session(cfg,event)
+    reflection=handler._memory_reflection
+    for current in range(3):
+        await reflection._record_pending_summary(sid,0,1,current,expected_revision=0,
+                                                 failure=RuntimeError('synthetic failure'))
+        pending=await cm.get_session_metadata(sid,'pending_summary',None)
+        assert pending is not None and pending['retry_count']==current+1
+        assert pending['start_index']==0 and pending['end_index']==1
+        assert pending['allow_single_message'] is True
+    assert pending['probe_after']>0
+    assert await cm.get_session_metadata(sid,'last_summarized_index',0)==0
+    await cm.store.delete_messages_from_position(sid,0)
+    assert await cm.get_session_metadata(sid,'pending_summary',None) is None
+
+
+def test_clamp_keeps_single_only_for_explicit_content_batch():
+    pending={'start_index':3,'end_index':6,'retry_count':1,'allow_single_message':True}
+    data={'last_summarized_index':3,'pending_summary':pending}
+    ConversationStore._clamp_summary_metadata(data,4)
+    assert data['pending_summary']['end_index']==4
+    assert data['pending_summary']['allow_single_message'] is True
+    ConversationStore._clamp_summary_metadata(data,3)
+    assert 'pending_summary' not in data
+    legacy={'pending_summary':{'start_index':0,'end_index':1,'retry_count':1}}
+    ConversationStore._clamp_summary_metadata(legacy,1)
+    assert 'pending_summary' not in legacy
+    malformed={'pending_summary':{'start_index':3,'end_index':3,'allow_single_message':True}}
+    ConversationStore._clamp_summary_metadata(malformed,4)
+    assert 'pending_summary' not in malformed
+
+
+@pytest.mark.asyncio
+async def test_real_locked_document_insert_retries_once_without_duplicates(tmp_path):
+    path=tmp_path/'documents.db';store=DocumentStorage(str(path))
+    await install_sqlite_safety(store);await store.initialize()
+    try:
+        async with store.engine.connect() as conn:
+            await conn.execute(text('PRAGMA busy_timeout=40'))
+        original=store.insert_document.__wrapped__
+        calls=[]
+        async def counted(*args,**kwargs):
+            calls.append(args[0]);return await original(*args,**kwargs)
+        proxy=SimpleNamespace(insert_document=counted)
+        install_document_insert_retry(proxy);install_document_insert_retry(proxy)
+        writer=sqlite3.connect(path,timeout=1)
+        try:
+            writer.execute('BEGIN IMMEDIATE')
+            task=asyncio.create_task(proxy.insert_document('synthetic-uuid','only one row',{}))
+            await asyncio.sleep(.18)
+            assert not task.done()
+            writer.rollback()
+            assert await asyncio.wait_for(task,3)>0
+        finally:writer.close()
+        assert len(calls)==2 and set(calls)=={'synthetic-uuid'}
+        with sqlite3.connect(path) as db:
+            assert db.execute('select count(*) from documents where doc_id=?',('synthetic-uuid',)).fetchone()[0]==1
+    finally:await store.close()
+
+
+def busy_error(statement='INSERT INTO documents (doc_id) VALUES (?)'):
+    error=sqlite3.OperationalError('database is locked')
+    error.sqlite_errorcode=sqlite3.SQLITE_BUSY
+    return OperationalError(statement,(),error)
+
+
+@pytest.mark.asyncio
+async def test_retry_is_bounded_and_never_replays_other_or_ambiguous_operations():
+    call=AsyncMock(side_effect=busy_error());storage=SimpleNamespace(insert_document=call)
+    install_document_insert_retry(storage)
+    with pytest.raises(OperationalError):await storage.insert_document('id','text',{})
+    assert call.await_count==3
+    for error in (busy_error(None),busy_error('UPDATE documents SET text=?'),
+                  OperationalError('INSERT INTO documents (doc_id) VALUES (?)',(),sqlite3.OperationalError('disk I/O error'))):
+        call=AsyncMock(side_effect=error);storage=SimpleNamespace(insert_document=call)
+        install_document_insert_retry(storage)
+        with pytest.raises(OperationalError):await storage.insert_document('id','text',{})
+        assert call.await_count==1
+    assert not _locked_document_insert(RuntimeError('database is locked'))
+
+
+@pytest.mark.asyncio
+async def test_cancellation_is_not_retried():
+    call=AsyncMock(side_effect=asyncio.CancelledError());storage=SimpleNamespace(insert_document=call)
+    install_document_insert_retry(storage)
+    with pytest.raises(asyncio.CancelledError):await storage.insert_document('id','text',{})
+    assert call.await_count==1
