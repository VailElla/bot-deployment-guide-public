diff --git a/core/graph_index_reconcile.py b/core/graph_index_reconcile.py
new file mode 100644
index 0000000..27c165d
--- /dev/null
+++ b/core/graph_index_reconcile.py
@@ -0,0 +1,199 @@
+"""Repair graph artifacts in bounded, resumable batches."""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import time
+from pathlib import Path
+
+from astrbot.api import logger
+from sqlalchemy import text
+
+from .faiss_async_persist import get_async_persister, install_async_persist
+from .sqlite_safety import finish_on_cancel
+
+
+class GraphIndexReconciler:
+    """Bound source inspection as well as repair work; persist the scan cursor."""
+    def __init__(self, engine):
+        self.engine = engine
+        self.status = {'runs':0, 'repaired':0, 'failures':0}
+        self.task = None
+        self._lock = asyncio.Lock()
+        self._cursor = 0
+        self._initialized = False
+        path = Path(engine.db_path)
+        self.cursor_path = path.with_name(path.stem + '.graph-reconcile-cursor.json')
+
+    async def _initialize(self):
+        if self._initialized:
+            return
+        def read():
+            try:
+                value = json.loads(self.cursor_path.read_text(encoding='utf8'))
+                return max(0,int(value['cursor'])) if value.get('version') == 1 else 0
+            except (OSError,ValueError,TypeError,KeyError):
+                return 0
+        self._cursor = await asyncio.to_thread(read)
+        # The existing scope-first index cannot serve a source-only lookup.
+        async with self.engine.faiss_db.document_storage.engine.begin() as conn:
+            await conn.execute(text('CREATE INDEX IF NOT EXISTS graph_reconcile_source '
+                                    'ON graph_entries(source_memory_id,vector_doc_id)'))
+        self._initialized = True
+
+    async def _checkpoint(self, cursor):
+        def write():
+            self.cursor_path.parent.mkdir(parents=True,exist_ok=True)
+            temp = self.cursor_path.with_suffix('.tmp')
+            with temp.open('w',encoding='utf8') as stream:
+                json.dump({'version':1,'cursor':cursor},stream)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temp,self.cursor_path)
+        await finish_on_cancel(asyncio.to_thread(write))
+        self._cursor = cursor
+
+    async def run_once(self, limit=25, *, scan_limit=128, budget_seconds=2.0):
+        """Inspect a bounded source page and start repairs within a soft deadline.
+
+        A repair already started completes its SQL/vector/link sequence even if
+        its deadline expires. The deadline gates the next unit of work, never
+        leaves a half-applied repair, and does not cancel other memory writers.
+        """
+        async with self._lock:
+            engine = self.engine
+            manager = engine.graph_memory_manager
+            report = dict(checked=0,missing=0,repaired=0,skipped=0,failed=0,cursor=self._cursor,cycle_complete=False)
+            if manager is None or limit <= 0 or scan_limit <= 0:
+                report['cycle_complete'] = True
+                return report
+            await self._initialize()
+            report['cursor'] = self._cursor
+            scan_limit = min(int(scan_limit),512)
+            deadline = time.monotonic()+max(0.0,float(budget_seconds))
+            last_cursor = self._cursor
+            async with manager._rebuild_gate:
+                if manager._rebuild_active:
+                    report['skipped'] = 1
+                    report['cycle_complete'] = True
+                    return report
+                storage = manager.graph_vector_retriever.faiss_db.embedding_storage
+                persister = get_async_persister(storage)
+                if persister is None:
+                    persister = install_async_persist(storage)
+                # Includes archived/empty records so cursor progress never needs
+                # a full JSON-filtered table scan or starves behind such records.
+                async with engine.db_connection.execute(
+                    'SELECT id,metadata FROM documents WHERE id>? ORDER BY id LIMIT ?',
+                    (self._cursor,scan_limit)) as cursor:
+                    rows = await cursor.fetchall()
+                if not rows:
+                    await self._checkpoint(0)
+                    report['cursor'] = 0
+                    last_cursor = 0
+                completed_page = False
+                for mid, raw_meta in rows:
+                    if time.monotonic() >= deadline or report['repaired']+report['failed'] >= limit:
+                        break
+                    mid = int(mid)
+                    # A failed item is advanced, then retried on the next cycle;
+                    # one corrupt record must not starve all later memories.
+                    advance = True
+                    try:
+                        report['checked'] += 1
+                        metadata = json.loads(raw_meta) if isinstance(raw_meta,str) else raw_meta or {}
+                        if metadata.get('status','active') != 'active':
+                            continue
+                        async with engine.db_connection.execute(
+                            'SELECT vector_doc_id FROM graph_entries WHERE source_memory_id=? '
+                            'AND vector_doc_id IS NOT NULL ORDER BY vector_doc_id LIMIT 64', (mid,)) as cursor:
+                            link_ids = {int(row[0]) for row in await cursor.fetchall()}
+                        present = await persister.contains_ids(link_ids) if link_ids else set()
+                        if present:
+                            docs = await manager.graph_vector_retriever.faiss_db.document_storage.get_documents(
+                                {}, ids=list(present), limit=64)
+                            matches = False
+                            for doc in docs:
+                                meta = doc.get('metadata') or {}
+                                if isinstance(meta,str):
+                                    meta = json.loads(meta)
+                                if int(meta.get('source_memory_id',-1)) == mid:
+                                    matches = True
+                                    break
+                            if matches:
+                                continue
+                        # Re-read authoritative status and content immediately
+                        # before deciding to repair; never resurrect an archive.
+                        records = await engine.faiss_db.document_storage.get_documents({},ids=[mid],limit=1)
+                        if not records or int(records[0]['id']) != mid:
+                            continue
+                        record = records[0]
+                        metadata = record.get('metadata') or {}
+                        if isinstance(metadata,str):
+                            metadata = json.loads(metadata)
+                        if metadata.get('status','active') != 'active':
+                            continue
+                        atoms = await engine.atom_store.get_by_parent(mid) if engine.atom_store else []
+                        if not manager.graph_extractor.extract(mid,record['text'],metadata,atoms).entries:
+                            continue
+                        report['missing'] += 1
+                        if time.monotonic() >= deadline:
+                            # Retry this not-yet-attempted item next pass.
+                            advance = False
+                            break
+                        async def repair():
+                            await manager.graph_vector_retriever.faiss_db.delete_documents(
+                                metadata_filters={'source_memory_id':mid})
+                            await manager._index_memory_now(mid,record['text'],metadata,atoms)
+                        await finish_on_cancel(repair())
+                        report['repaired'] += 1
+                    except asyncio.CancelledError:
+                        raise
+                    except Exception:
+                        report['failed'] += 1
+                        self.status['failures'] += 1
+                        logger.warning('[graph_reconcile] source=%s inspection/repair failed',mid,exc_info=True)
+                    finally:
+                        # If deadline was reached after discovering a missing
+                        # record but before repair, leave it at the next boundary.
+                        if advance:
+                            last_cursor = mid
+                else:
+                    completed_page = True
+                if completed_page and len(rows) < scan_limit:
+                    report['cycle_complete'] = True
+                    last_cursor = 0
+                if last_cursor != self._cursor:
+                    await self._checkpoint(last_cursor)
+            report['cursor'] = self._cursor
+            report['elapsed_seconds'] = max(0.0,time.monotonic()-(deadline-max(0.0,float(budget_seconds))))
+            self.status['runs'] += 1
+            self.status['repaired'] += report['repaired']
+            self.status['last'] = report
+            if report['repaired']:
+                logger.info('[graph_reconcile] repaired=%s checked=%s cursor=%s',report['repaired'],report['checked'],self._cursor)
+            return report
+
+    async def run(self):
+        await asyncio.sleep(30)
+        while True:
+            delay = 300
+            try:
+                report = await self.run_once()
+                # Finish the current sweep in short slices, then wait five
+                # minutes. A larger database must not turn one sweep into hours.
+                delay = 300 if report['cycle_complete'] else 5
+                self.status['next_delay_seconds'] = delay
+            except asyncio.CancelledError:
+                raise
+            except Exception:
+                self.status['failures'] += 1
+                logger.warning('[graph_reconcile] pass failed; retry in 300 seconds',exc_info=True)
+            await asyncio.sleep(delay)
+
+    async def close(self):
+        if self.task is not None:
+            self.task.cancel()
+            await asyncio.gather(self.task,return_exceptions=True)
+            self.task = None
