+
+def _locked_document_insert(error):
+    """Match a failed SQLite INSERT, never an ambiguous commit or later step."""
+    if not isinstance(error, OperationalError) or not isinstance(error.orig, sqlite3.OperationalError):
+        return False
+    statement = error.statement
+    if not isinstance(statement, str) or not re.match(
+        r'^\s*INSERT\s+INTO\s+(?:"documents"|documents)(?:\s|\()', statement, re.I
+    ):
+        return False
+    code = getattr(error.orig, 'sqlite_errorcode', None)
+    if isinstance(code, int):
+        return code & 0xff == sqlite3.SQLITE_BUSY
+    return str(error.orig).strip().lower() == 'database is locked'
+
+
+def install_document_insert_retry(storage):
+    """Retry only a rolled-back document INSERT that SQLite reports as busy."""
+    if getattr(storage, '_livingmemory_insert_retry', False):
+        return
+    original = storage.insert_document
+
+    @functools.wraps(original)
+    async def insert(*args, **kwargs):
+        for delay in (0.25, 1.0, None):
+            try:
+                return await original(*args, **kwargs)
+            except OperationalError as exc:
+                if delay is None or not _locked_document_insert(exc):
+                    raise
+                await asyncio.sleep(delay)
+
+    storage.insert_document = insert
+    storage._livingmemory_insert_retry = True
 
 
 async def finish_on_cancel(awaitable):
