+"""Regression: a shared group must never assign another sender's source window."""
+import pytest
+from astrbot_plugin_livingmemory.core.memory_scope import resolve_capture_session, resolve_memory_scope
+from astrbot_plugin_livingmemory.core.managers.conversation_manager import ConversationManager
+from astrbot_plugin_livingmemory.storage.conversation_store import ConversationStore
+from astrbot_plugin_livingmemory.tests.test_memory_scope import _Event, _config
+
+@pytest.mark.asyncio
+async def test_group_two_senders_keep_distinct_summary_sources(tmp_path):
+    config=_config(filtering_settings={'memory_scope_mode':'user'})
+    store=ConversationStore(str(tmp_path/'per-user.db'))
+    await store.initialize()
+    manager=ConversationManager(store,memory_scope_config=config)
+    a=_Event(session_id='qq:GroupMessage:group-a',sender_id='10001')
+    b=_Event(session_id=a.unified_msg_origin,sender_id='20002')
+    other_group=_Event(session_id='qq:GroupMessage:group-b',sender_id='10001')
+    private=_Event(session_id='qq:FriendMessage:10001',sender_id='10001')
+    try:
+        await manager.add_message_from_event(a,'user','A drinks tea')
+        await manager.add_message_from_event(b,'user','B drinks coffee')
+        await manager.add_message_from_event(a,'assistant','I remember tea')
+        ka=resolve_capture_session(config,a); kb=resolve_capture_session(config,b)
+        assert ka!=kb
+        am=await manager.get_messages_range(ka,0,10)
+        bm=await manager.get_messages_range(kb,0,10)
+        assert [m.content for m in am]==['A drinks tea','I remember tea']
+        assert [m.content for m in bm]==['B drinks coffee']
+        assert all('coffee' not in m.content for m in am)
+        assert resolve_memory_scope(config,a)==resolve_memory_scope(config,other_group)==resolve_memory_scope(config,private)
+        assert resolve_memory_scope(config,a)!=resolve_memory_scope(config,b)
+        assert a.unified_msg_origin=='qq:GroupMessage:group-a'
+    finally:
+        await store.close()
+
+def test_other_modes_and_forced_isolation_preserve_original_capture():
+    event=_Event(session_id='qq:GroupMessage:group-a')
+    for mode in ('legacy','session','global'):
+        assert resolve_capture_session(_config(filtering_settings={'memory_scope_mode':mode}),event)==event.unified_msg_origin
+    config=_config(filtering_settings={'memory_scope_mode':'user','isolated_sessions':event.unified_msg_origin})
+    assert resolve_capture_session(config,event)==event.unified_msg_origin
