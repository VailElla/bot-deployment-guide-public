+"""Bounded reconciliation preserves progress, scope and live vector membership."""
+import asyncio
+from unittest.mock import AsyncMock
+
+import faiss
+import numpy as np
+import pytest
+
+from astrbot_plugin_livingmemory.core.faiss_async_persist import get_async_persister
+from astrbot_plugin_livingmemory.core.graph_index_reconcile import GraphIndexReconciler
+from .test_recall_reliability import engine  # noqa: F401
+
+
+@pytest.mark.asyncio
+async def test_source_scan_is_bounded_and_cursor_survives_reopen(engine):
+    mids=[]
+    for i in range(7):
+        mids.append(await engine.add_memory(f'Alice plans to visit Kyoto on day {i}.'))
+    first=GraphIndexReconciler(engine)
+    report=await first.run_once(scan_limit=2,budget_seconds=10)
+    assert report['checked'] == 2 and report['cursor'] == mids[1]
+    second=GraphIndexReconciler(engine)
+    report=await second.run_once(scan_limit=2,budget_seconds=10)
+    assert report['checked'] == 2 and report['cursor'] == mids[3]
+    await second.run_once(scan_limit=2,budget_seconds=10)
+    report=await second.run_once(scan_limit=2,budget_seconds=10)
+    assert report['checked'] == 1 and report['cursor'] == 0
+    assert report['cycle_complete'] is True
+    assert (await second.run_once(scan_limit=2,budget_seconds=10))['checked'] == 2
+
+
+@pytest.mark.asyncio
+async def test_repair_budget_advances_across_passes(engine,monkeypatch):
+    manager=engine.graph_memory_manager
+    original=manager.graph_vector_retriever.add_memory_entries
+    monkeypatch.setattr(manager.graph_vector_retriever,'add_memory_entries',AsyncMock(side_effect=RuntimeError('missing')))
+    for i in range(5):
+        await engine.add_memory(f'Alice decided to visit Kyoto on day {i}.')
+    monkeypatch.setattr(manager.graph_vector_retriever,'add_memory_entries',original)
+    repair=GraphIndexReconciler(engine)
+    reports=[await repair.run_once(limit=2,scan_limit=10,budget_seconds=10) for _ in range(3)]
+    assert [r['repaired'] for r in reports] == [2,2,1]
+    assert all(r['checked'] <= 2 for r in reports)
+
+
+@pytest.mark.asyncio
+async def test_zero_time_budget_starts_no_inspection_or_repair(engine):
+    await engine.add_memory('Alice plans to visit Kyoto tomorrow.')
+    report=await GraphIndexReconciler(engine).run_once(budget_seconds=0)
+    assert report['checked'] == report['repaired'] == 0 and report['cursor'] == 0
+
+
+@pytest.mark.asyncio
+async def test_membership_cache_tracks_mutations_without_full_rescan(engine,monkeypatch):
+    storage=engine.graph_memory_manager.graph_vector_retriever.faiss_db.embedding_storage
+    persister=get_async_persister(storage)
+    await storage.insert(np.array([1.,0.,0.,0.]),90001)
+    original=faiss.vector_to_array
+    reads=[]
+    def counted(value):
+        reads.append(1)
+        return original(value)
+    monkeypatch.setattr(faiss,'vector_to_array',counted)
+    assert await persister.contains_ids([90001,90002]) == {90001}
+    await storage.insert_batch(np.array([[1.,0.,0.,0.],[0.,1.,0.,0.]],dtype='float32'),[90002,90003])
+    await storage.delete([90001])
+    assert await persister.contains_ids([90001,90002,90003]) == {90002,90003}
+    assert len(reads) == 1
+    replacement=faiss.IndexIDMap(faiss.IndexFlatL2(4))
+    replacement.add_with_ids(np.array([[1.,0.,0.,0.]],dtype='float32'),np.array([90004],dtype='int64'))
+    storage.index=replacement
+    assert await persister.contains_ids([90002,90004]) == {90004}
+    assert len(reads) == 2
