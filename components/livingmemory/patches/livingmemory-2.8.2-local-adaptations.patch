@@ -0,0 +1,99 @@
+"""A native session-scoped group stream alongside the existing user stream."""
+from __future__ import annotations
+
+import copy
+
+from .base.config_manager import ConfigManager
+from .event_handler_modules import GroupCapture, MemoryReflection, MessageUtils
+from .layered_memory import group_scope
+from .memory_scope import is_event_memory_allowed
+
+
+class GroupConversationView:
+    """Share the native store, cache and revision locks; select only the group buffer."""
+    def __init__(self, manager):
+        self.manager = manager
+
+    def __getattr__(self, name):
+        return getattr(self.manager, name)
+
+    async def add_message_from_event(self, event, role, content):
+        return await self.manager.add_message_from_event(
+            event, role, content, capture_session_id=event.unified_msg_origin)
+
+
+class GroupProcessorView:
+    def __init__(self, processor):
+        self.processor = processor
+
+    def __getattr__(self, name):
+        return getattr(self.processor, name)
+
+    async def process_conversation(self, *args, **kwargs):
+        content, metadata, importance = await self.processor.process_conversation(*args, **kwargs)
+        return content, dict(metadata, memory_layer='group'), importance
+
+    async def process_topic_batch(self, *args, **kwargs):
+        results = await self.processor.process_topic_batch(*args, **kwargs)
+        return [dict(result,metadata=dict(result['metadata'],memory_layer='group')) for result in results]
+
+
+class GroupMessageUtils(MessageUtils):
+    async def build_dedup_key(self, event, session_id, content):
+        key = await super().build_dedup_key(event, session_id, content)
+        return f'group:{session_id}:{key}' if key else None
+
+
+class GroupMemory:
+    def __init__(self, owner):
+        self.owner = owner
+        config = copy.deepcopy(owner.config_manager.get_all())
+        config['filtering_settings']['memory_scope_mode'] = 'session'
+        config['filtering_settings']['use_session_filtering'] = True
+        config['group_memory']['enabled'] = False
+        self.config = ConfigManager(config)
+        self.conversations = GroupConversationView(owner.conversation_manager)
+        self.message_utils = GroupMessageUtils(self.config, self.conversations)
+        # Distinct dedup cache is necessary: the user stream has already captured this event.
+        self.capture = GroupCapture(self.config, self.conversations, self.message_utils)
+        self.processor = GroupProcessorView(owner.memory_processor)
+        self.reflection = MemoryReflection(
+            owner.context, self.config, owner.memory_engine, self.processor, self.conversations,
+            self.message_utils, owner._storage_tasks, owner._storage_sessions_inflight,
+            owner._storage_state_lock, None, storage_session_tasks=owner._storage_session_tasks)
+
+    def allowed(self, event):
+        return (group_scope(self.owner.config_manager, event) is not None
+                and is_event_memory_allowed(self.owner.config_manager, event))
+
+    async def capture_event(self, event):
+        if self.allowed(event):
+            await self.capture.handle_all_group_messages(event)
+
+    async def reflect_event(self, event, response):
+        if self.allowed(event):
+            await self.reflection.handle_memory_reflection(event, response)
+
+    async def reset_context(self, event):
+        sid = group_scope(self.owner.config_manager, event)
+        if sid and self.allowed(event):
+            await self.conversations.clear_session(sid)
+
+    async def summarize_existing(self, event, force=False):
+        sid = group_scope(self.owner.config_manager, event)
+        if not sid or not self.allowed(event):
+            return None
+        running = self.owner._storage_session_tasks.get(sid)
+        if running and not running.done():
+            return running
+        count = await self.conversations.store.get_message_count(sid)
+        cursor = await self.conversations.get_session_metadata(sid, 'last_summarized_index', 0)
+        pending = await self.conversations.get_session_metadata(sid, 'pending_summary', None)
+        if force and pending:
+            pending = dict(pending, retry_count=0)
+        revision = await self.reflection._read_session_revision(sid)
+        plan = await self.reflection._build_reflection_window(event, sid, count, cursor, pending, revision)
+        if plan is None:
+            return None
+        await self.reflection._schedule_reflection(plan)
+        return self.owner._storage_session_tasks.get(sid)
