+ assert await cm.get_session_metadata(sid,'pending_summary',None) is None
+ assert bg.metrics['recovery_probes']==1
+
+@pytest.mark.asyncio
+async def test_not_yet_due_probe_keeps_original_range_and_count(system):
+ cfg,cm,engine,processor,h,bg=system;e=await seed(h);sid=resolve_capture_session(cfg,e)
+ pending={'start_index':0,'end_index':10,'retry_count':3,'probe_after':time.time()+600}
+ await cm.update_session_metadata(sid,'pending_summary',pending)
+ assert await bg.candidates({sid})==[]
+ assert await cm.get_session_metadata(sid,'pending_summary',{})==pending
+ assert await cm.get_session_metadata(sid,'last_summarized_index',0)==0
+ processor.process_conversation.assert_not_awaited()
+
+@pytest.mark.asyncio
+async def test_probe_failure_preserves_probe_counter_and_raw_cursor(system):
+ cfg,cm,engine,processor,h,bg=system;e=await seed(h);sid=resolve_capture_session(cfg,e)
+ await cm.update_session_metadata(sid,'pending_summary',{'start_index':0,'end_index':10,'retry_count':3,'probe_count':1,'probe_after':time.time()-1})
+ processor.process_conversation.side_effect=ValueError('bad response')
+ with patch(PERSONA,new=AsyncMock(return_value=None)):await bg.run_once({sid})
+ pending=await cm.get_session_metadata(sid,'pending_summary',{})
+ assert pending['retry_count']==1 and pending['probe_count']==2
+ assert pending['probe_after']>time.time()
+ assert await cm.get_session_metadata(sid,'last_summarized_index',0)==0
+
