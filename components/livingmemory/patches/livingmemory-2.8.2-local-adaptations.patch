+"""Native regression tests for graph lock and cancellation recovery."""
+# ruff: noqa: F811 - pytest fixtures are imported for this module
+
+import asyncio
+import json
+import sqlite3
+from contextlib import closing
+from unittest.mock import AsyncMock
+
+import pytest
+from astrbot.core.db.vec_db.faiss_impl.document_storage import DocumentStorage
+from sqlalchemy import text
+
+from astrbot_plugin_livingmemory.core.graph_index_reconcile import GraphIndexReconciler
+from astrbot_plugin_livingmemory.core.sqlite_safety import (
+    finish_on_cancel,
+    install_sqlite_safety,
+)
+
+from .test_recall_reliability import engine  # noqa: F401
+
+
+@pytest.mark.asyncio
+async def test_wal_reader_does_not_block_writer_and_all_pool_connections_configured(
+    tmp_path,
+):
+    path = tmp_path / "doc.db"
+    store = DocumentStorage(str(path))
+    await install_sqlite_safety(store)
+    await install_sqlite_safety(store)
+    await store.initialize()
+    try:
+        with closing(sqlite3.connect(path)) as reader:
+            reader.execute("BEGIN")
+            assert reader.execute("SELECT count(*) FROM documents").fetchone()[0] == 0
+            await asyncio.wait_for(store.insert_document("a", "hello", {}), 2)
+            assert reader.execute("SELECT count(*) FROM documents").fetchone()[0] == 0
+            reader.rollback()
+            assert reader.execute("PRAGMA journal_mode").fetchone()[0] == "wal"
+        connections = await asyncio.gather(*[store.engine.connect() for _ in range(7)])
+        try:
+            for conn in connections:
+                assert (
+                    await conn.execute(text("PRAGMA busy_timeout"))
+                ).scalar() == 10000
+        finally:
+            await asyncio.gather(*[conn.close() for conn in connections])
+    finally:
+        await store.close()
+
+
+@pytest.mark.asyncio
+async def test_busy_writer_waits_for_release(tmp_path):
+    path = tmp_path / "doc.db"
+    store = DocumentStorage(str(path))
+    await install_sqlite_safety(store)
+    await store.initialize()
+    try:
+        with closing(sqlite3.connect(path)) as writer:
+            writer.execute("BEGIN IMMEDIATE")
+            task = asyncio.create_task(store.insert_document("a", "hello", {}))
+            await asyncio.sleep(0.1)
+            assert not task.done()
+            writer.rollback()
+            assert await asyncio.wait_for(task, 2) > 0
+    finally:
+        await store.close()
+
+
+@pytest.mark.asyncio
+async def test_repeated_cancel_waits_for_cleanup():
+    started, release, cleaned = asyncio.Event(), asyncio.Event(), asyncio.Event()
+
+    async def operation():
+        started.set()
+        try:
+            await release.wait()
+        finally:
+            cleaned.set()
+
+    task = asyncio.create_task(finish_on_cancel(operation()))
+    await started.wait()
+    task.cancel()
+    await asyncio.sleep(0)
+    task.cancel()
+    await asyncio.sleep(0)
+    assert not task.done() and not cleaned.is_set()
+    release.set()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+    assert cleaned.is_set()
+
+
+@pytest.mark.asyncio
+async def test_operation_failure_is_preserved():
+    async def fail():
+        raise ValueError("original failure")
+
+    with pytest.raises(ValueError, match="original failure"):
+        await finish_on_cancel(fail())
+
+
+@pytest.mark.asyncio
+async def test_reconcile_repairs_failed_write_and_is_idempotent(engine, monkeypatch):
+    manager = engine.graph_memory_manager
+    original = manager.graph_vector_retriever.add_memory_entries
+    monkeypatch.setattr(
+        manager.graph_vector_retriever,
+        "add_memory_entries",
+        AsyncMock(side_effect=RuntimeError("locked")),
+    )
+    mid = await engine.add_memory(
+        "Alice decided to visit Kyoto tomorrow.",
+        metadata={"key_facts": ["Alice will visit Kyoto tomorrow."]},
+    )
+    monkeypatch.setattr(manager.graph_vector_retriever, "add_memory_entries", original)
+    before = await engine.get_memory(mid)
+    repair = GraphIndexReconciler(engine)
+    report = await repair.run_once()
+    assert report["repaired"] == 1
+    assert (await repair.run_once())["repaired"] == 0
+    assert (await engine.get_memory(mid))["text"] == before["text"]
+    docs = await manager.graph_vector_retriever.faiss_db.document_storage.get_documents(
+        {"source_memory_id": mid}
+    )
+    assert len(docs) == 1
+
+
+@pytest.mark.asyncio
+async def test_reconcile_skips_archived_and_preserves_scope(engine, monkeypatch):
+    manager = engine.graph_memory_manager
+    original = manager.graph_vector_retriever.add_memory_entries
+    monkeypatch.setattr(
+        manager.graph_vector_retriever,
+        "add_memory_entries",
+        AsyncMock(side_effect=RuntimeError("locked")),
+    )
+    mid = await engine.add_memory(
+        "Alice plans a Kyoto trip.", session_id="private-user-a", persona_id="p"
+    )
+    other = await engine.add_memory(
+        "Bob plans an Osaka trip.", session_id="private-user-b", persona_id="p"
+    )
+    monkeypatch.setattr(manager.graph_vector_retriever, "add_memory_entries", original)
+    async with engine.db_connection.execute(
+        "SELECT metadata FROM documents WHERE id=?", (other,)
+    ) as c:
+        meta = json.loads((await c.fetchone())[0])
+    meta["status"] = "archived"
+    await engine.db_connection.execute(
+        "UPDATE documents SET metadata=? WHERE id=?", (json.dumps(meta), other)
+    )
+    await engine.db_connection.commit()
+    report = await GraphIndexReconciler(engine).run_once(limit=1)
+    assert report["repaired"] == 1
+    docs = await manager.graph_vector_retriever.faiss_db.document_storage.get_documents(
+        {"source_memory_id": mid}
+    )
+    assert json.loads(docs[0]["metadata"])["session_id"] == "private-user-a"
+    assert not await manager.graph_vector_retriever.faiss_db.document_storage.get_documents(
+        {"source_memory_id": other}
+    )
+
+
+@pytest.mark.asyncio
+async def test_reconcile_repairs_missing_faiss_vector_without_duplicate_sql(engine):
+    import faiss
+
+    mid = await engine.add_memory("Alice will travel to Kyoto in November.")
+    db = engine.graph_memory_manager.graph_vector_retriever.faiss_db
+    docs = await db.document_storage.get_documents({"source_memory_id": mid})
+    await db.embedding_storage.delete([docs[0]["id"]])
+    assert (await GraphIndexReconciler(engine).run_once())["repaired"] == 1
+    docs = await db.document_storage.get_documents({"source_memory_id": mid})
+    assert len(docs) == 1
+    assert int(docs[0]["id"]) in set(
+        map(int, faiss.vector_to_array(db.embedding_storage.index.id_map))
+    )
