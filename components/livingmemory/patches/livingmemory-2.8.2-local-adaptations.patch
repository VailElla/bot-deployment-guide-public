new file mode 100644
index 0000000..77f846f
--- /dev/null
+++ b/core/content_batching.py
@@ -0,0 +1,139 @@
+"""Content-sized, message-aligned summary windows with optional local topic hints.
+
+Token counts are conservative text estimates, not the remote model's tokenizer.
+No source text is truncated and no cursor is advanced here.
+"""
+from __future__ import annotations
+
+import math
+import re
+
+from astrbot.api import logger
+
+
+def enabled(config):
+    return bool(config.get('background_summary.content_batching', False))
+
+
+def estimate_text_tokens(text):
+    text = str(text or '')
+    ascii_chars = sum(ord(c) < 128 for c in text)
+    cjk = len(re.findall(r'[\u3400-\u9fff]', text))
+    return math.ceil(ascii_chars / 3 + cjk * 1.25 + (len(text)-ascii_chars-cjk) * 2)
+
+
+def message_tokens(message):
+    label = f"{message.role}|{getattr(message, 'sender_name', '')}|{getattr(message, 'sender_id', '')}|{message.timestamp}"
+    return estimate_text_tokens(message.content) + estimate_text_tokens(label) + 8
+
+
+def window_tokens(messages):
+    return sum(message_tokens(m) for m in messages)
+
+
+def closed_boundary(messages, config):
+    """A substantial older segment followed by a real time gap is complete."""
+    minimum = config.get('background_summary.batch_min_tokens', 1024)
+    gap = config.get('background_summary.batch_topic_gap_seconds', 300)
+    accumulated = 0
+    for i, message in enumerate(messages):
+        if i and accumulated >= minimum and message.timestamp - messages[i-1].timestamp >= gap:
+            return i
+        accumulated += message_tokens(message)
+    return None
+
+
+def bounded_prefix(messages, config):
+    limit = config.get('background_summary.batch_max_tokens', 24576)
+    total = 0
+    for i, message in enumerate(messages):
+        size = message_tokens(message)
+        if i and total + size > limit:
+            return i
+        total += size
+    # An oversized individual message stays atomic; native failure/retry retains it.
+    return len(messages)
+
+
+def _cosine(a, b):
+    norm = math.sqrt(sum(x*x for x in a) * sum(x*x for x in b))
+    if not norm or len(a) != len(b):
+        return None
+    return sum(x*y for x, y in zip(a, b)) / norm
+
+
+async def select_window(messages, config, embedding_provider=None):
+    """Return a contiguous prefix; a topic shift is only a conservative hint."""
+    end = bounded_prefix(messages, config)
+    selected = messages[:end]
+    if config.get('background_summary.multi_topic_summary', False):
+        # Read several topics together; the LLM returns separate topic records.
+        return end, 'multi_topic_read'
+    natural = closed_boundary(selected, config)
+    if natural is not None:
+        return natural, 'time_gap'
+    fallback = 'token_limit' if end < len(messages) else 'available_context'
+    if (not config.get('background_summary.batch_semantic_split', True)
+            or embedding_provider is None
+            or window_tokens(selected) < config.get('background_summary.batch_min_tokens', 1024)*2):
+        return end, fallback
+
+    # At most 48 small text samples. The local BGE encoder's input is limited;
+    # samples are only for boundary hints, never substituted for source messages.
+    chunks = []
+    start = 0
+    tokens = 0
+    for i, message in enumerate(selected):
+        tokens += message_tokens(message)
+        if tokens >= 512 or i == len(selected)-1:
+            text = '\n'.join(m.content for m in selected[start:i+1])
+            chunks.append((i+1, text if len(text) <= 320 else text[:240]+'\n'+text[-80:]))
+            start = i+1
+            tokens = 0
+    if len(chunks) < 4 or len(chunks) > 48:
+        return end, fallback
+    try:
+        import asyncio
+        vectors = await asyncio.wait_for(embedding_provider.get_embeddings([c[1] for c in chunks]), timeout=20)
+        if len(vectors) != len(chunks):
+            raise ValueError('embedding count mismatch')
+        threshold = config.get('background_summary.batch_topic_similarity', 0.60)
+        for i in range(2, len(chunks)-1):
+            boundary = chunks[i-1][0]
+            if window_tokens(selected[:boundary]) < config.get('background_summary.batch_min_tokens', 1024):
+                continue
+            # Require coherent discussion on both sides; one unusual message
+            # cannot by itself turn into a new summary boundary.
+            left = _cosine(vectors[i-2], vectors[i-1])
+            right = _cosine(vectors[i], vectors[i+1])
+            cross = [_cosine(a, b) for a in vectors[i-2:i] for b in vectors[i:i+2]]
+            if left is None or right is None or any(v is None for v in cross):
+                continue
+            if left >= 0.65 and right >= 0.65 and max(cross) < threshold:
+                # Refine the coarse block boundary to a message boundary. This
+                # avoids pulling the start of the next topic into the old one.
+                lo = chunks[i-3][0] if i >= 3 else 0
+                hi = chunks[i][0]
+                if hi-lo <= 32:
+                    try:
+                        texts = [m.content if len(m.content)<=320 else m.content[:240]+'\n'+m.content[-80:] for m in selected[lo:hi]]
+                        fine = await asyncio.wait_for(embedding_provider.get_embeddings(texts), timeout=10)
+                        if len(fine) == len(texts):
+                            left_mean = [(a+b)/2 for a,b in zip(vectors[i-2],vectors[i-1])]
+                            right_mean = [(a+b)/2 for a,b in zip(vectors[i],vectors[i+1])]
+                            scores = []
+                            for vector in fine:
+                                a,b = _cosine(vector,left_mean),_cosine(vector,right_mean)
+                                scores.append(None if a is None or b is None else b-a)
+                            for k in range(2,len(scores)-1):
+                                four = scores[k-2:k+2]
+                                if (all(v is not None for v in four) and max(four[:2]) < -0.08
+                                        and min(four[2:]) > 0.08
+                                        and window_tokens(selected[:lo+k]) >= config.get('background_summary.batch_min_tokens',1024)):
+                                    return lo+k,'semantic_shift'
+                    except Exception:
+                        pass  # A refinement failure retains the coarse boundary.
+                return boundary, 'semantic_shift'
+    except Exception as exc:
+        logger.debug('LivingMemory topic boundary fallback: %s', type(exc).__name__)
+    return end, fallback
