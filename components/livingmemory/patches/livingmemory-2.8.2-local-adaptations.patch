+import pytest
+from astrbot_plugin_livingmemory.core.processors.memory_processor import MemoryProcessor
+from tests.test_background_summary import system
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('message,minimum', [('unexpected status 422: 当前活跃会话数已达上限', 59), ('last status: 429 Too Many Requests', 59)])
+async def test_rate_limit_stops_retries_and_blocks_following_requests(message, minimum):
+    provider = SimpleNamespace(provider_config={'id':'test'}, text_chat=AsyncMock(side_effect=RuntimeError(message)))
+    processor = MemoryProcessor(llm_provider=provider)
+    with pytest.raises(RuntimeError, match='status'):
+        await processor._call_llm_with_retry('p','s')
+    assert provider.text_chat.await_count == 1
+    assert processor.rate_limit_delay() >= minimum
+    with pytest.raises(RuntimeError, match='等待后重试'):
+        await processor._call_llm_with_retry('p','s')
+    assert provider.text_chat.await_count == 1
+    processor._rate_limited_until=0
+    provider.text_chat.side_effect=None
+    provider.text_chat.return_value=SimpleNamespace(completion_text='ok')
+    assert await processor._call_llm_with_retry('p','s') == 'ok'
+
+@pytest.mark.asyncio
+async def test_summary_admission_is_delegated_to_provider():
+    active=0
+    peak=0
+    async def call(**kwargs):
+        nonlocal active, peak
+        active+=1;peak=max(peak,active)
+        await asyncio.sleep(0.01)
+        active-=1
+        return SimpleNamespace(completion_text='ok')
+    provider=SimpleNamespace(provider_config={'id':'test'}, text_chat=call)
+    processor=MemoryProcessor(llm_provider=provider)
+    assert await asyncio.gather(*(processor._call_llm_with_retry('p','s') for _ in range(4))) == ['ok']*4
+    assert peak == 4
+
+@pytest.mark.asyncio
+async def test_scheduler_defers_without_admitting_while_limited(system):
+    cfg,cm,engine,processor,h,bg=system
+    processor.rate_limit_delay=lambda: 240
+    bg.candidates=AsyncMock(side_effect=AssertionError('must not scan'))
+    result=await bg.run_once()
+    assert result['phase']=='upstream_backoff'
+    assert not bg.admissions
+    assert bg.next_delay() >= 240
+
+@pytest.mark.asyncio
+async def test_rate_limited_source_uses_one_minute_not_normal_cooldown(system):
+    cfg, cm, engine, processor, h, bg = system
+    cfg._config['background_summary'].update(adaptive=True, adaptive_cooldown_seconds=120)
+    now=10000
+    session=SimpleNamespace(message_count=2,last_active_at=0)
+    message=SimpleNamespace(timestamp=0,content='old')
+    limited,_=bg.adaptive_due(session,0,{'last_attempt_at':now,'retry_after':now+60,'rate_limited_retry':True},[message],now)
+    normal,_=bg.adaptive_due(session,0,{'last_attempt_at':now,'retry_after':now+900},[message],now)
+    assert limited==now+60
+    assert normal==now+900
