diff --git a/core/background_summary.py b/core/background_summary.py
new file mode 100644
index 0000000..e8dc031
--- /dev/null
+++ b/core/background_summary.py
@@ -0,0 +1,456 @@
+"""Bounded native summaries for stored contexts that received no bot response."""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+import time
+import uuid
+from pathlib import Path
+from types import SimpleNamespace
+
+from astrbot.api import logger
+from astrbot.api.platform import MessageType
+
+from .memory_scope import is_event_memory_allowed, resolve_capture_session, resolve_memory_scope
+from .content_batching import enabled as content_batching, window_tokens, closed_boundary
+
+STATE_KEY = 'background_summary_state'
+
+
+class BackgroundSummary:
+    def __init__(self, owner, data_dir=None):
+        self.owner = owner
+        self.config = owner.config_manager
+        self.path = Path(data_dir) / 'background_summary_state.json' if data_dir else None
+        self.task = None
+        self._restart_task = None
+        self._restored_retry_at = 0.0
+        self.stopping = False
+        self.lock = asyncio.Lock()
+        self.wake = asyncio.Event()
+        self.admissions = []
+        self.next_due_at = None
+        self.active_jobs = {}
+        self.last_scan_started = 0
+        self.metrics = {'passes': 0, 'completed': 0, 'failed': 0, 'phase': 'idle', 'started_at': time.time()}
+        if self.path and self.path.is_file():
+            try:
+                saved = json.loads(self.path.read_text(encoding='utf8'))
+                retry_at = saved.get('upstream_retry_at', 0)
+                if isinstance(retry_at, (int, float)):
+                    self._restored_retry_at = min(time.time() + 60, max(0, retry_at))
+                self.admissions = [t for t in saved.get('admissions', [])
+                                   if isinstance(t, (int, float)) and time.time() - 3600 < t <= time.time()]
+                for key in ('passes', 'completed', 'failed', 'last_success_at', 'started_at'):
+                    value = saved.get(key)
+                    if isinstance(value, (int, float)) and value >= 0:
+                        self.metrics[key] = value
+            except (OSError, ValueError):
+                logger.warning('LivingMemory background metrics could not be read')
+
+    def setting(self, key, default):
+        return self.config.get('background_summary.' + key, default)
+
+    def status(self):
+        return dict(self.metrics, health=self.health(), enabled=self.setting('enabled', False),
+                    adaptive=self.setting('adaptive', False),
+                    content_batching=content_batching(self.config),
+                    multi_topic_summary=self.setting('multi_topic_summary',False),
+                    admitted_last_hour=len(self.recent_admissions()),
+                    loop_running=bool(self.task and not self.task.done()))
+
+    def health(self):
+        delay = self.rate_limit_delay()
+        if delay > 0:
+            return 'upstream_backoff'
+        if (self.metrics.get('due_streams', 0) or self.metrics.get('blocked_streams', 0)) and time.time() - (self.metrics.get('last_success_at') or self.metrics.get('started_at', time.time())) > 1800:
+            return 'stalled'
+        return 'running' if self.task and not self.task.done() else 'stopped'
+
+    def probe_due(self, pending, previous):
+        explicit = pending.get('probe_after')
+        if isinstance(explicit, (int, float)):
+            return max(explicit, previous.get('retry_after', 0))
+        # Legacy exhausted records get a slow probe, never permanent exclusion.
+        return max(previous.get('retry_after', 0), previous.get('last_attempt_at', 0) + self.setting('failure_backoff_seconds', 900))
+
+    def recent_admissions(self):
+        now = time.time()
+        self.admissions = [t for t in self.admissions if now - 3600 < t <= now]
+        return self.admissions
+
+    def notify(self):
+        """Coalesce capture events; no scan or model call runs on the message path."""
+        if not self.stopping and self.setting('adaptive', False):
+            self.wake.set()
+
+    def rate_limit_delay(self):
+        get_delay = getattr(self.owner.memory_processor, 'rate_limit_delay', None)
+        value = get_delay() if callable(get_delay) else 0
+        return max(0, self._restored_retry_at - time.time(), value if isinstance(value, (int, float)) else 0)
+
+    def next_delay(self):
+        now = time.time()
+        if not self.setting('adaptive', False):
+            return max(1, self.rate_limit_delay(), self.setting('interval_seconds', 300) - (now - self.last_scan_started))
+        deadline = self.next_due_at
+        limit = self.setting('max_summaries_per_hour', 24)
+        admissions = self.recent_admissions()
+        if limit > 0 and len(admissions) >= limit:
+            deadline = admissions[-limit] + 3600
+        due = now + self.setting('max_scan_interval_seconds', 1800) if deadline is None else deadline
+        return max(1, self.rate_limit_delay(), self.last_scan_started + self.setting('min_scan_interval_seconds', 30) - now,
+                   min(due - now, self.setting('max_scan_interval_seconds', 1800)))
+
+    async def wait_for_work(self, delay):
+        """A burst can wake an idle scheduler, but cannot bypass the scan throttle."""
+        try:
+            await asyncio.wait_for(self.wake.wait(), timeout=delay)
+        except asyncio.TimeoutError:
+            return
+        remaining = self.last_scan_started + self.setting('min_scan_interval_seconds', 30) - time.time()
+        if remaining > 0:
+            await asyncio.sleep(remaining)
+
+    async def persist(self):
+        if not self.path:
+            return
+        snapshot = dict(self.metrics)
+        delay = self.rate_limit_delay()
+        snapshot['upstream_retry_at'] = time.time() + delay if delay else 0
+        snapshot['health'] = self.health()
+        if snapshot['health'] == 'stalled' and time.time() - self.metrics.get('last_stall_warning_at', 0) >= 1800:
+            self.metrics['last_stall_warning_at'] = snapshot['last_stall_warning_at'] = time.time()
+            logger.warning('LivingMemory backlog stalled: due=%s paused=%s', self.metrics.get('due_streams', 0), self.metrics.get('blocked_streams', 0))
+        snapshot['admissions'] = list(self.recent_admissions())
+        def write():
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            temp = self.path.with_name(self.path.name + '.' + uuid.uuid4().hex + '.tmp')
+            temp.write_text(json.dumps(snapshot, ensure_ascii=False, indent=2), encoding='utf8')
+            os.replace(temp, self.path)
+        try:
+            await asyncio.to_thread(write)
+        except OSError as exc:
+            logger.warning('LivingMemory background metrics write failed: %s', type(exc).__name__)
+
+    def start(self):
+        if self.stopping or not self.setting('enabled', False) or (self.task and not self.task.done()):
+            return
+        self.task = asyncio.create_task(self.loop())
+        self.task.add_done_callback(self._on_loop_done)
+
+    def _on_loop_done(self, task):
+        if self.stopping or not self.setting('enabled', False):
+            return
+        error = None if task.cancelled() else task.exception()
+        logger.warning('LivingMemory summary loop stopped unexpectedly: %s; restarting in 60s', type(error).__name__)
+        if self._restart_task is None or self._restart_task.done():
+            self._restart_task = asyncio.create_task(self._restart_after_failure(task))
+
+    async def _restart_after_failure(self, previous):
+        await asyncio.sleep(60)
+        if not self.stopping and self.task is previous and previous.done():
+            self.start()
+
+    async def loop(self):
+        try:
+            self.metrics['next_run_at'] = time.time() + self.setting('startup_delay_seconds', 60)
+            await asyncio.sleep(self.setting('startup_delay_seconds', 60))
+            while not self.stopping and self.setting('enabled', False):
+                self.wake.clear()
+                self.last_scan_started = time.time()
+                try:
+                    await self.run_once(rolling=True)
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    self.metrics.update(phase='scan_failed', last_error=type(exc).__name__)
+                    logger.warning('LivingMemory background scan failed: %s', type(exc).__name__)
+                delay = self.next_delay()
+                self.metrics['next_run_at'] = time.time() + delay
+                await self.persist()
+                if self.setting('adaptive', False):
+                    await self.wait_for_work(delay)
+                else:
+                    await asyncio.sleep(delay)
+        except asyncio.CancelledError:
+            raise
+
+    async def stop(self):
+        self.stopping = True
+        if self._restart_task and not self._restart_task.done():
+            self._restart_task.cancel()
+            await asyncio.gather(self._restart_task, return_exceptions=True)
+        if self.task and not self.task.done():
+            self.task.cancel()
+            await asyncio.gather(self.task, return_exceptions=True)
+        self.metrics.update(phase='stopped', next_run_at=None)
+
+    def binding(self, sid, message):
+        origin = sid.rsplit(':livingmemory-user:', 1)[0]
+        parts = origin.split(':', 2)
+        is_group = bool(message.group_id) and len(parts) == 3 and parts[1] == 'GroupMessage'
+        event = SimpleNamespace(
+            unified_msg_origin=origin,
+            get_sender_id=lambda: str(message.sender_id),
+            get_sender_name=lambda: str(message.sender_name or message.sender_id),
+            get_platform_name=lambda: str(message.platform or 'unknown'),
+            get_platform_id=lambda: parts[0],
+            get_group_id=lambda: parts[2] if is_group else '',
+            get_message_type=lambda: MessageType.GROUP_MESSAGE if is_group else MessageType.FRIEND_MESSAGE,
+        )
+        if not is_event_memory_allowed(self.config, event):
+            return None
+        if ':livingmemory-user:' in sid:
+            if resolve_capture_session(self.config, event) != sid:
+                return None
+            return event, self.owner._memory_reflection
+        group = self.owner.group_memory
+        if group and is_group and sid == origin and group.allowed(event):
+            return event, group.reflection
+        return None
+
+    async def candidates(self, only_sessions=None):
+        cm = self.owner.conversation_manager
+        now = time.time()
+        selected = []
+        blocked = 0
+        self.next_due_at = None
+        for session in await cm.store.get_recent_sessions(limit=10000):
+            sid = session.session_id
+            if only_sessions is not None and sid not in only_sessions:
+                continue
+            if only_sessions is None and sid.startswith(('lmverify:', 'lmdual-', 'lmbg-verify:', 'lmadaptive-verify:', 'lmcontent-verify:', 'lmtopics-verify:', 'lmrepair:')):
+                continue
+            meta = session.metadata or {}
+            cursor = int(meta.get('last_summarized_index', 0) or 0)
+            pending = meta.get('pending_summary') or {}
+            count = session.message_count
+            if count - cursor < (1 if content_batching(self.config) else self.setting('min_idle_messages', 2)):
+                continue
+            previous = meta.get(STATE_KEY) or {}
+            if pending.get('retry_count', 0) >= 3:
+                blocked += 1
+                retry_at = self.probe_due(pending, previous)
+                self.next_due_at = retry_at if self.next_due_at is None else min(self.next_due_at, retry_at)
+                if now < retry_at:
+                    continue
+            adaptive = self.setting('adaptive', False)
+            first = await cm.get_messages_range(sid, cursor, min(count, cursor + self.setting('max_messages_per_job', 100)) if adaptive else cursor + 1)
+            if first:
+                if adaptive:
+                    humans = [m for m in first if m.role == 'user']
+                    if not humans or not self.binding(sid, humans[-1]):
+                        continue
+                    due, reason = self.adaptive_due(session, cursor, previous, first, now)
+                    self.next_due_at = due if self.next_due_at is None else min(self.next_due_at, due)
+                    if now < due:
+                        continue
+                    selected.append((0, first[0].timestamp, previous.get('last_attempt_at', 0), sid))
+                    continue
+                if now < max(previous.get('retry_after', 0), previous.get('last_attempt_at', 0) + (60 if previous.get('rate_limited_retry') else self.setting('cooldown_seconds', 600))):
+                    continue
+                if count - cursor < self.setting('min_messages', 10) and now - session.last_active_at < self.setting('idle_seconds', 600):
+                    continue
+                priority = 0 if count - cursor >= self.setting('min_messages', 10) else 1
+                selected.append((priority, first[0].timestamp, previous.get('last_attempt_at', 0), sid))
+        self.metrics['blocked_streams'] = blocked
+        return sorted(selected)
+
+    def adaptive_due(self, session, cursor, state, window, now):
+        """Choose a deadline from volume, quiet time and oldest pending message age."""
+        count = session.message_count - cursor
+        idle_deadline = session.last_active_at + self.setting('idle_seconds', 600)
+        options = [(idle_deadline, 'idle'),
+                   (window[0].timestamp + self.setting('max_wait_seconds', 1800), 'max_wait')]
+        if content_batching(self.config):
+            tokens = window_tokens(window)
+            if tokens >= self.setting('batch_target_tokens', 8192):
+                options.append((session.last_active_at + self.setting('quiet_seconds', 180), 'content_pause'))
+            if tokens >= self.setting('batch_urgent_tokens', 16384):
+                options.append((now, 'token_volume'))
+            if closed_boundary(window, self.config) is not None:
+                options.append((now, 'closed_segment'))
+        elif count >= self.setting('min_messages', 10):
+            options.append((session.last_active_at + self.setting('quiet_seconds', 90), 'conversation_pause'))
+        chars = sum(len(m.content or '') for m in window)
+        if not content_batching(self.config) and (count >= self.setting('urgent_messages', 40) or chars >= self.setting('min_characters', 4000)):
+            options.append((now, 'volume'))
+        deadline, reason = min(options)
+        deadline = max(deadline, state.get('retry_after', 0),
+                       state.get('last_attempt_at', 0) + (60 if state.get('rate_limited_retry') else self.setting('adaptive_cooldown_seconds', 120)))
+        return deadline, reason
+
+    async def run_once(self, only_sessions=None, *, rolling=False):
+        if self.stopping or self.owner._shutting_down or not self.setting('enabled', False) or self.lock.locked():
+            return {'busy_or_disabled': True}
+        async with self.lock:
+            if self.rate_limit_delay() > 0:
+                self.metrics.update(phase='upstream_backoff', admitted_this_pass=0)
+                return self.status()
+            self.metrics.update(phase='scanning', last_scan_at=time.time())
+            candidates = await self.candidates(only_sessions)
+            self.metrics.update(passes=self.metrics['passes'] + 1, due_streams=len(candidates), admitted_this_pass=0)
+            # The background loop refills free workers immediately. Manual calls
+            # keep their bounded per-pass behavior. Native source locks/cursors
+            # and the provider's chat/shared request pool remain authoritative.
+            limit = max(1, self.setting('max_sessions_per_run', 4))
+            offset = 0
+            workers = set()
+            self.metrics['scheduler_mode'] = 'rolling' if rolling else 'bounded'
+            try:
+                while offset < len(candidates) or workers:
+                    while offset < len(candidates) and len(workers) < limit:
+                        if self.stopping or self.owner._shutting_down or self.rate_limit_delay() > 0:
+                            break
+                        if not rolling and self.metrics['admitted_this_pass'] + len(workers) >= limit:
+                            break
+                        hourly = self.setting('max_summaries_per_hour', 24)
+                        # Reserve capacity for workers still preparing admission.
+                        if self.setting('adaptive', False) and hourly > 0 and len(self.recent_admissions()) + len(workers) >= hourly:
+                            self.metrics['budget_limited'] = True
+                            break
+                        self.metrics['budget_limited'] = False
+                        _, _, _, sid = candidates[offset]
+                        offset += 1
+                        workers.add(asyncio.create_task(self.submit_one(sid)))
+                    if not workers:
+                        break
+                    done, workers = await asyncio.wait(workers, return_when=asyncio.FIRST_COMPLETED)
+                    # Retrieve every result before propagating an error; do not
+                    # leave background exceptions or untracked workers behind.
+                    results = await asyncio.gather(*done, return_exceptions=True)
+                    for result in results:
+                        if isinstance(result, BaseException):
+                            raise result
+            finally:
+                # Cancelling a wrapper preserves shielded native storage tasks;
+                # the owner's shutdown/drain still tracks and settles them.
+                for worker in workers:
+                    worker.cancel()
+                if workers:
+                    await asyncio.gather(*workers, return_exceptions=True)
+            self.metrics['phase'] = 'sleeping'
+            await self.persist()
+            return self.status()
+
+    def refresh_active_metrics(self):
+        jobs = list(self.active_jobs.values())
+        self.metrics['active_sources'] = jobs
+        self.metrics['active_count'] = len(jobs)
+        for key in ('current_source', 'current_messages', 'current_estimated_tokens'):
+            self.metrics.pop(key, None)
+        if jobs:
+            self.metrics.update(current_source=jobs[0]['source'], current_messages=jobs[0]['messages'],
+                                current_estimated_tokens=jobs[0]['estimated_tokens'])
+
+    async def submit_one(self, sid):
+        cm = self.owner.conversation_manager
+        chosen = False
+        native_task = None
+        async with self.owner._storage_state_lock:
+            if sid in self.owner._storage_sessions_inflight:
+                return
+            self.owner._storage_sessions_inflight.add(sid)
+            chosen = True
+        try:
+            revision = await cm.get_session_revision(sid)
+            count = await cm.store.get_message_count(sid)
+            cursor = int(await cm.get_session_metadata(sid, 'last_summarized_index', 0) or 0)
+            if cursor < 0 or cursor > count:
+                return
+            pending = await cm.get_session_metadata(sid, 'pending_summary', None)
+            if count - cursor < (1 if content_batching(self.config) else self.setting('min_idle_messages', 2)):
+                return
+            session = await cm.store.get_session(sid)
+            if not session:
+                return
+            start = int((pending or {}).get('start_index', cursor))
+            end = min(count, start + self.setting('max_messages_per_job', 100))
+            window = await cm.get_messages_range(sid, start, end)
+            humans = [m for m in window if m.role == 'user']
+            if not humans:
+                return
+            reason = 'legacy_threshold'
+            if self.setting('adaptive', False):
+                previous = await cm.get_session_metadata(sid, STATE_KEY, {}) or {}
+                due, reason = self.adaptive_due(session, cursor, previous, window, time.time())
+                if time.time() < due:
+                    return
+            elif count - cursor < self.setting('min_messages', 10) and time.time() - session.last_active_at < self.setting('idle_seconds', 600):
+                return
+            binding = self.binding(sid, humans[-1])
+            if not binding:
+                return
+            event, reflection = binding
+            if ':livingmemory-user:' in sid and len({str(m.sender_id) for m in humans}) != 1:
+                return
+            if pending and pending.get('retry_count', 0) >= 3:
+                async with cm._session_lock(sid):
+                    fresh = await cm.store.get_session(sid)
+                    if not fresh:
+                        return
+                    current = (fresh.metadata or {}).get('pending_summary') or {}
+                    previous = (fresh.metadata or {}).get(STATE_KEY) or {}
+                    if current.get('retry_count', 0) >= 3:
+                        if time.time() < self.probe_due(current, previous):
+                            return
+                        probes = int(current.get('probe_count', 0)) + 1
+                        delay = min(3600, max(self.setting('failure_backoff_seconds', 900), 300 * 2 ** min(probes - 1, 4)))
+                        pending = dict(current, retry_count=0, probe_count=probes, probe_after=time.time() + delay)
+                        await cm._update_session_metadata_locked(sid, 'pending_summary', pending)
+                        self.metrics['recovery_probes'] = self.metrics.get('recovery_probes', 0) + 1
+                    else:
+                        pending = current or None
+            plan = await reflection._build_reflection_window(event, sid, end, cursor, pending, revision)
+            expected_scope = resolve_memory_scope(reflection.config_manager, event) or sid
+            if plan is None or plan.memory_scope != expected_scope:
+                return
+            if self.rate_limit_delay() > 0 or self.stopping or self.owner._shutting_down:
+                return
+            state = dict(await cm.get_session_metadata(sid, STATE_KEY, {}) or {}, last_attempt_at=time.time())
+            if not await cm.update_session_metadata_if_revision(sid, STATE_KEY, state, revision):
+                return
+            if self.setting('adaptive', False):
+                self.admissions.append(time.time())
+            source_hash = hashlib.sha256(sid.encode()).hexdigest()[:12]
+            self.active_jobs[source_hash] = dict(source=source_hash, messages=len(plan.history_messages),
+                                                estimated_tokens=window_tokens(plan.history_messages))
+            self.metrics.update(phase='summarizing', last_trigger=reason,
+                                admitted_this_pass=self.metrics['admitted_this_pass'] + 1)
+            self.refresh_active_metrics()
+            await self.persist()
+
+            async def work():
+                ok = False
+                try:
+                    ok = await reflection._storage_task(plan.session_id, plan.history_messages, plan.persona_id,
+                        plan.start_index, plan.end_index, plan.retry_count,
+                        memory_scope=plan.memory_scope, expected_revision=plan.expected_revision,
+                        triggered_by='background_summary')
+                    if ok:
+                        state.update(last_success_at=time.time(), retry_after=0, rate_limited_retry=False)
+                        self.metrics['completed'] += 1
+                        self.metrics['last_success_at'] = time.time()
+                        logger.info('LivingMemory background summary committed: source=%s messages=%s', source_hash, len(plan.history_messages))
+                    else:
+                        limited = self.rate_limit_delay() > 0
+                        state['rate_limited_retry'] = limited
+                        state['retry_after'] = time.time() + (60 if limited else self.setting('failure_backoff_seconds', 900))
+                        self.metrics['failed'] += 1
+                    await cm.update_session_metadata_if_revision(sid, STATE_KEY, state, revision)
+                    return ok
+                finally:
+                    self.active_jobs.pop(source_hash, None)
+                    self.refresh_active_metrics()
+                    await self.persist()
+            native_task = asyncio.create_task(work())
+            self.owner._storage_tasks.add(native_task)
+            self.owner._storage_session_tasks[sid] = native_task
+            native_task.add_done_callback(lambda t, source=sid: reflection._on_storage_task_done(t, source))
+            await asyncio.shield(native_task)
+        finally:
+            if chosen and native_task is None:
+                self.owner._storage_sessions_inflight.discard(sid)
