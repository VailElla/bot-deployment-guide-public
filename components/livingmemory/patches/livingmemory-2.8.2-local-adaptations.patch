+from astrbot_plugin_livingmemory.core.layered_memory import event_scopes, search_event_memories
+from astrbot_plugin_livingmemory.core.memory_scope import resolve_memory_scope, resolve_capture_session
+from astrbot_plugin_livingmemory.core.managers.conversation_manager import ConversationManager
+from astrbot_plugin_livingmemory.storage.conversation_store import ConversationStore
+from astrbot_plugin_livingmemory.core.tools import MemoryMemorizeTool, MemorySearchTool, MemoryForgetTool
+
+class Event:
+    sequence=0
+    def __init__(self,user='a',group='one',text='hello',private=False):
+        Event.sequence+=1
+        self.user=user;self.group=group;self.text=text;self.private=private;self.extra={}
+        self.unified_msg_origin=f'test:{"FriendMessage" if private else "GroupMessage"}:{group}'
+        self.message_obj=SimpleNamespace(message_id=str(Event.sequence),timestamp=1700000000+Event.sequence,sender=SimpleNamespace(user_id=user,nickname=user))
+    def get_message_type(self):return MessageType.FRIEND_MESSAGE if self.private else MessageType.GROUP_MESSAGE
+    def get_sender_id(self):return self.user
+    def get_sender_name(self):return self.user
+    def get_self_id(self):return 'bot'
+    def get_platform_name(self):return 'test'
+    def get_platform_id(self):return 'test-instance'
+    def get_group_id(self):return '' if self.private else self.group
+    def get_message_str(self):return self.text
+    def get_messages(self):return [Plain(text=self.text)]
+    def get_extra(self,key,default=None):return self.extra.get(key,default)
+    def set_extra(self,key,value):self.extra[key]=value
+    def is_admin(self):return True
+
+def config():
+    return ConfigManager({'filtering_settings':{'memory_scope_mode':'user','use_persona_filtering':False},
+        'group_memory':{'enabled':True},'reflection_engine':{'summary_trigger_rounds':2},
+        'memory_dedup':{'enabled':False},'agent_tools':{'forget_tool_cooldown_seconds':0}})
+
+class Engine:
+    def __init__(self):self.docs={};self.next_id=1;self.calls=[]
+    async def add_memory(self,content,session_id=None,persona_id=None,importance=0.5,metadata=None,**kwargs):
+        mid=self.next_id;self.next_id+=1
+        self.docs[mid]={'id':mid,'text':content,'metadata':dict(metadata or {},session_id=session_id,persona_id=persona_id,status='active')}
+        return mid
+    async def search_memories(self,query,k,session_id=None,persona_id=None):
+        self.calls.append(session_id)
+        return [SimpleNamespace(doc_id=d['id'],content=d['text'],metadata=dict(d['metadata']),final_score=0.8,score_breakdown={})
+                for d in self.docs.values() if d['metadata']['session_id']==session_id and d['metadata']['status']=='active'][:k]
+    async def get_memory(self,mid):return self.docs.get(mid)
+    async def archive_memories(self,ids,**kwargs):
+        for mid in ids:self.docs[mid]['metadata']['status']='archived'
+        return len(ids)
+
+@pytest_asyncio.fixture
+async def system(tmp_path):
+    cfg=config();store=ConversationStore(str(tmp_path/'dual.db'));await store.initialize()
+    cm=ConversationManager(store,memory_scope_config=cfg)
