+import asyncio
+import time
+from types import SimpleNamespace
+import pytest
+from astrbot_plugin_livingmemory.core.managers.conversation_manager import ConversationManager
+from astrbot_plugin_livingmemory.storage.conversation_store import ConversationStore
+from astrbot_plugin_livingmemory.core.models.conversation_models import Message
+from astrbot_plugin_livingmemory.core.rotation_barrier import archive_group
+
+
+@pytest.fixture
+async def setup_barrier(tmp_path):
+    store=ConversationStore(str(tmp_path/'rotation.db'));await store.initialize()
+    cm=ConversationManager(store);owner=SimpleNamespace(conversation_manager=cm,
+        background_summary=None,_shutting_down=False,group_memory=object(),
+        _storage_session_tasks={},_storage_sessions_inflight=set(),_storage_state_lock=asyncio.Lock(),_storage_tasks=set())
+    origin='test:GroupMessage:123';calls=[]
+    class Reflection:
+        async def _build_reflection_window(self,event,sid,count,cursor,pending,revision):
+            end=min(count,cursor+2)
+            return SimpleNamespace(start_index=cursor,end_index=end,history_messages=await cm.get_messages_range(sid,cursor,end),persona_id='p',memory_scope=sid)
+        async def _storage_task(self,sid,messages,persona,start,end,retry,**kwargs):
+            calls.append((sid,start,end))
+            return await cm.commit_summary_progress(sid,end,kwargs['expected_revision'])
+        def _on_storage_task_done(self,task,sid):
+            owner._storage_tasks.discard(task);owner._storage_sessions_inflight.discard(sid)
+            if owner._storage_session_tasks.get(sid) is task:owner._storage_session_tasks.pop(sid,None)
+    reflection=Reflection();owner.background_summary=SimpleNamespace(binding=lambda sid,m:(object(),reflection))
+    for sid,n,group in [(origin,7,origin),(origin+':livingmemory-user:1',5,origin),(origin+':livingmemory-user:2',3,origin),('other:GroupMessage:99',3,'other:GroupMessage:99')]:
+        for i in range(n):
+            await store.add_message(Message(id=0,session_id=sid,role='user',content='fact '+str(i),sender_id='1',group_id=group,timestamp=time.time()+i*.001))
+    yield owner,cm,store,origin,reflection,calls
+    await store.close()
+
+
+@pytest.mark.asyncio
+async def test_every_user_and_group_all_windows_have_durable_receipts(setup_barrier):
+    owner,cm,store,origin,reflection,calls=setup_barrier
+    result=await archive_group(owner,origin)
+    assert result['complete'] and len(result['streams'])==3
+    assert len(calls)==9
+    assert await cm.get_session_metadata('other:GroupMessage:99','last_summarized_index',0)==0
+    for suffix,count in [('',7),(':livingmemory-user:1',5),(':livingmemory-user:2',3)]:
+        session=await store.get_session(origin+suffix)
+        assert session.metadata['last_summarized_index']==count
+        assert session.metadata['rotation_receipt']['boundary_count']==count
+    assert not cm._rotation_pins
+
+
+@pytest.mark.asyncio
+async def test_failed_window_does_not_confirm_boundary(setup_barrier):
+    owner,cm,store,origin,reflection,calls=setup_barrier
+    async def fail(*a,**kw):return False
+    reflection._storage_task=fail
+    with pytest.raises(RuntimeError,match='not_committed'):await archive_group(owner,origin)
+    assert await cm.get_session_metadata(origin,'rotation_receipt',None) is None
+    assert not cm._rotation_pins
+
+
+@pytest.mark.asyncio
+async def test_pending_old_native_summary_is_joined(setup_barrier):
+    owner,cm,store,origin,reflection,calls=setup_barrier
+    async def old():
