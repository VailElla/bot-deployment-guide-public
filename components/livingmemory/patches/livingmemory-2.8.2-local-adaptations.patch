index 0000000..adfba0b
--- /dev/null
+++ b/core/response_preferences.py
@@ -0,0 +1,208 @@
+"""Load bounded, source-bound personal reply styles outside relevance ranking.
+
+Only a small vocabulary of presentation choices becomes a preference. Neither
+arbitrary source text nor group memories are promoted into instructions. This
+is a read-only projection of active personal memories and unsummarized messages;
+it has no second store that could outlive a memory archive or history rollback.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import time
+from datetime import datetime
+
+from .memory_scope import resolve_memory_scope, is_event_memory_allowed
+
+HEADER = "<LivingMemory-ResponsePreferences>"
+FOOTER = "</LivingMemory-ResponsePreferences>"
+KEYS = ("kaomoji", "hearts", "periods", "length")
+LABELS = {
+    ("kaomoji", True): "回复适量加入颜文字",
+    ("kaomoji", False): "回复不使用颜文字",
+    ("hearts", True): "回复适量加入爱心符号",
+    ("hearts", False): "回复不使用爱心符号",
+    ("periods", True): "正常使用句号",
+    ("periods", False): "回复不加句号",
+    ("length", "concise"): "回复尽量简短",
+    ("length", "detailed"): "回复尽量详细",
+}
+
+
+def _dict(value):
+    if isinstance(value, dict):
+        return value
+    try:
+        value = json.loads(value or "{}")
+        return value if isinstance(value, dict) else {}
+    except (ValueError, TypeError):
+        return {}
+
+
+def _timestamp(value, default=0.0):
+    try:
+        number = float(value)
+    except (ValueError, TypeError):
+        try:
+            number = datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
+        except (ValueError, TypeError, OverflowError):
+            return default
+    return number if 0 < number <= time.time() + 300 else default
+
+
+def parse_styles(text: str) -> dict:
+    """Conservative direct-request parser; values are enums, never free text.
+
+    This intentionally abstains on quotations, questions, hypothetical requests,
+    temporary task instructions, and statements about other people.
+    """
+    if not isinstance(text, str) or len(text) > 1000:
+        return {}
+    text = text.strip().strip("。！! ")
+    durable_length = bool(re.search(r'以后|今后|后续|每次|平时|一直', text))
+    if any(x in text for x in ('"', '“', '”', '「', '」', '`', '\n', '如果', '假如', '比如',
+                               '他说', '她说', '有人说', '这次', '本次', '这一条', '今天', '暂时')):
+        return {}
+    if re.search(r"(?:忘掉|取消|清除)(?:我|之前|以前|所有|的)*(?:聊天|回复|回答)(?:风格|偏好|习惯)", text) or re.search(
+        r"(?:以后|今后)?恢复默认(?:的)?(?:回复|聊天)(?:风格)?$", text
+    ):
+        return dict.fromkeys(KEYS)
+    # Every clause must itself look like a request, rather than a quoted or
+    # narrated sentence merely containing a matching phrase.
+    result = {}
+    for clause in re.split(r"[，,。；;！!]", text):
+        clause = clause.strip()
+        if not clause or len(clause) > 140 or re.search(r"[?？]|(?:吗|么)$", clause):
+            continue
+        clause = re.sub(r"^(?:你|您)(?:跟我|和我)?(?:聊天|说话)?", "", clause)
+        clause = re.sub(r"^(?:以后|今后|后续|每次|一直|都|请|麻烦|记得|希望你|要求你|回复|回答|说话|聊天|的时候|时|要|也|还|不仅|并且|而且|再)+", "", clause)
+        if re.search(r"不要不|不用不|别不|不必不", clause):
+            continue
+        for key, word in (("kaomoji", "颜文字"), ("hearts", "爱心(?:符号)?"), ("periods", "句号")):
+            negative = re.fullmatch(r"(?:不要|别|不用|无需|不再|不必|取消)(?:再|都|给我|任何|一点|一个|的)*(?:加|使用|用|带|写|添加)?(?:一点|一些|任何|的)*" + word + r"(?:了|啦|吧|哦)?", clause)
+            positive = re.fullmatch(r"(?:正常|继续|记得|给我|适当|适量)?(?:加|使用|用|带|写|添加)(?:上|点|一点|一些|个|的)*" + word + r"(?:了|啦|吧|哦)?", clause)
+            if negative or positive:
+                result[key] = not bool(negative)
+        if durable_length and (re.fullmatch(r"(?:尽量|都)?(?:简短|简洁|精简)(?:点|一点|一些|些)?(?:回复|回答)?", clause) or re.fullmatch(r"(?:短|少说)(?:点|一点|一些|些)", clause)):
+            result["length"] = "concise"
+        if durable_length and (re.fullmatch(r"(?:尽量|都)?(?:详细|具体)(?:点|一点|一些|些)?(?:回复|回答)?", clause) or re.fullmatch(r"(?:多说|展开)(?:点|一点|一些|些)", clause)):
+            result["length"] = "detailed"
+    return result
+
+
+def styles_from_fact(fact: str, sender: str) -> dict:
+    # Summaries must explicitly attribute the request to this sender. Bot
+    # promises alone, nicknames, and other participants' preferences are ignored.
+    match = re.fullmatch(
+        r"(?:用户|发言者)?" + re.escape(sender) + r"(?:随后|后来|再次)?(?:要求|希望|请求|提醒)(?:我|Bot|bot)(.+)",
+        str(fact).strip().rstrip("。"),
+    )
+    return parse_styles(match.group(1)) if match else {}
+
+
+def styles_from_message(content: str, *, group: bool, bot: str) -> dict:
+    if not isinstance(content, str):
+        return {}
+    # Only the new utterance is considered; quoted message bodies aren't the
+    # sender's own preference. Historical group requests must address this bot.
+    content = re.sub(r"^\[引用[^\]]*\]\s*", "", content)
+    mentions = re.findall(r"\[At:([^\]]+)\]", content)
+    if group and (not bot or mentions != [bot]):
+        return {}
+    if mentions and any(item != bot for item in mentions):
+        return {}
+    return parse_styles(re.sub(r"\[At:[^\]]+\]\s*", "", content).strip())
+
+
+async def load_preferences(engine, conversations, config, event, current_text: str, persona_id=None):
+    """Return latest explicit values + provenance, bound to the real event."""
+    if not is_event_memory_allowed(config, event):
+        return []
+    scope = resolve_memory_scope(config, event)
+    if not scope or not scope.startswith("livingmemory:user:"):
+        return []
+    sender = str(event.get_sender_id() or "")
+    bot = str(event.get_self_id() or "")
+    if not sender or sender == bot:
+        return []
+    candidates = []
+    # Pending original messages bridge the delay before background summaries.
+    # Consume only the uncommitted suffix: archived summarized memories must
+    # never be resurrected from their old captured messages.
+    conn = getattr(getattr(conversations, 'store', None), 'connection', None)
+    suffix = ':livingmemory-user:' + hashlib.sha256(scope.encode('utf8')).hexdigest()
+    if conn is not None:
+        async with conn.execute(
+            "SELECT session_id, metadata, message_count FROM sessions WHERE substr(session_id, -?)=? "
+            "ORDER BY last_active_at DESC LIMIT 32", (len(suffix), suffix)
+        ) as cursor:
+            sessions = await cursor.fetchall()
+        for sid, raw, count in sessions:
+            meta = _dict(raw)
+            try:
+                start = max(0, int(meta.get('last_summarized_index', 0)), int(count) - 512)
+            except (ValueError, TypeError):
+                continue
+            async with conn.execute(
+                "SELECT id,role,content,sender_id,timestamp FROM messages WHERE session_id=? "
+                "ORDER BY timestamp ASC,id ASC LIMIT 512 OFFSET ?", (sid, start)
+            ) as cursor:
+                rows = await cursor.fetchall()
+            for mid, role, content, author, ts in rows:
+                if role != 'user' or str(author) != sender:
+                    continue
+                values = styles_from_message(content, group=':GroupMessage:' in sid, bot=bot)
+                if values:
+                    candidates.append((_timestamp(ts), 1, int(mid), 0, values, f'message:{mid}'))
+    conn = getattr(engine, "db_connection", None)
+    if conn is not None:
+        async with conn.execute(
+            "SELECT id, metadata FROM documents WHERE json_extract(metadata,'$.session_id')=? "
+            "AND COALESCE(json_extract(metadata,'$.status'),'active')='active' "
+            "AND EXISTS (SELECT 1 FROM json_each(metadata,'$.key_facts') WHERE "
+            "value LIKE '%颜文字%' OR value LIKE '%爱心%' OR value LIKE '%句号%' "
+            "OR value LIKE '%简短%' OR value LIKE '%详细%' OR value LIKE '%简洁%' "
+            "OR value LIKE '%精简%' OR value LIKE '%风格%' OR value LIKE '%回复偏好%' "
+            "OR value LIKE '%聊天偏好%') "
+            "ORDER BY id DESC LIMIT 128", (scope,)
+        ) as cursor:
+            rows = await cursor.fetchall()
+        for row in rows:
+            mid, raw = row
+            meta = _dict(raw)
+            if persona_id is not None and meta.get('persona_id') != persona_id:
+                continue
+            ts = _timestamp(meta.get('source_time_end'), _timestamp(meta.get('create_time')))
+            facts = meta.get('key_facts', [])
+            if not isinstance(facts, list):
+                continue
+            for index, fact in enumerate(facts[:40]):
+                values = styles_from_fact(fact, sender)
+                if values:
+                    candidates.append((ts, 0, int(mid), index, values, f'memory:{mid}'))
+    # Current direct request can arrive before the group capture hook completes.
+    origin = str(event.unified_msg_origin)
+    values = styles_from_message(current_text, group=':GroupMessage:' in origin, bot=bot)
+    if values:
+        raw_ts = getattr(getattr(event, 'message_obj', None), 'timestamp', None)
+        candidates.append((_timestamp(raw_ts, time.time()), 2, 0, 0, values, 'current_message'))
+    latest = {}
+    for ts, kind, mid, index, values, source in sorted(candidates):
+        for key, value in values.items():
+            latest[key] = {'key': key, 'value': value, 'source': source}
+    return [latest[key] for key in KEYS if key in latest and latest[key]['value'] is not None]
+
+
+def format_preferences(items: list, sender: str) -> str:
+    lines = [HEADER, f'当前发送者ID：{sender}',
+             '以下为该发送者明确提出的个人回复风格，仅对本轮回复生效；本轮的新要求优先。',
+             '每轮以本轮此段为准，不把历史轮次其他发送者的偏好套给当前发送者。']
+    for item in items:
+        label = LABELS.get((item['key'], item['value']))
+        if label:
+            lines.append(f"- {label}（来源：{item['source']}）")
+    if not items:
+        lines.append('本轮没有已确认的个人回复风格偏好。')
+    lines.append(FOOTER)
+    return '\n'.join(lines)
diff --git a/core/rotation_barrier.py b/core/rotation_barrier.py
new file mode 100644
index 0000000..5ab887b
--- /dev/null
+++ b/core/rotation_barrier.py
@@ -0,0 +1,117 @@
+"""Drain every source stream to a fixed, verifiable boundary without resetting it."""
+from __future__ import annotations
+import asyncio
+import hashlib
+import json
+
+
+def fingerprint(messages):
+    return hashlib.sha256(json.dumps([(m.id,m.role,m.content,m.sender_id,m.timestamp)
+        for m in messages],ensure_ascii=False).encode()).hexdigest()
+
+
+async def archive_group(owner, origin):
+    cm = owner.conversation_manager
+    background = owner.background_summary
+    if not background or owner._shutting_down or not owner.group_memory:
+        raise RuntimeError('memory_not_ready')
+    # Native captures use chat-local user buffers, even when destination user
+    # memories are shared. Query source provenance; don't enumerate a capped LRU.
+    async with cm.store.connection.execute(
+        'SELECT DISTINCT session_id FROM messages WHERE group_id=?', (origin,)) as cur:
+        sessions = sorted(r[0] for r in await cur.fetchall())
+    if origin not in sessions:
+        # No group stream means capture may be disabled or not yet finished.
+        raise RuntimeError('group_capture_missing')
+    pins = getattr(cm, '_rotation_pins', None)
+    if pins is None:
+        pins = cm._rotation_pins = set()
+    # One rotation job per origin is guaranteed by the caller. User source
+    # buffers are chat-local, so these pins are never shared with another group.
+    pins.update(sessions)
+    receipts = []
+    try:
+        for sid in sessions:
+            running = owner._storage_session_tasks.get(sid)
+            if running and not running.done():
+                await asyncio.shield(running)
+            async with cm._session_lock(sid):
+                revision = await cm.get_session_revision(sid)
+                count = await cm.store.get_message_count(sid)
+                prefix = await cm.get_messages_range(sid, 0, count)
+            if len(prefix) != count:
+                raise RuntimeError('unstable_memory_boundary')
+            humans = [m for m in prefix if m.role == 'user']
+            binding = background.binding(sid, humans[-1]) if humans else None
+            if not binding:
+                raise RuntimeError('memory_scope_unresolvable')
+            event, reflection = binding
+            expected = fingerprint(prefix)
+            while True:
+                if await cm.get_session_revision(sid) != revision:
+                    raise RuntimeError('memory_revision_changed')
+                cursor = int(await cm.get_session_metadata(sid,'last_summarized_index',0) or 0)
+                if cursor >= count:
+                    break
+                # Share native single-flight admission with background and reply
+                # summaries; never run a second writer for the same source stream.
+                async with owner._storage_state_lock:
+                    busy = sid in owner._storage_sessions_inflight
+                    if not busy:
+                        owner._storage_sessions_inflight.add(sid)
+                if busy:
+                    running = owner._storage_session_tasks.get(sid)
+                    if running and not running.done():
+                        await asyncio.shield(running)
+                    else:
+                        await asyncio.sleep(.05)
+                    continue
+                task = None
+                try:
+                    if fingerprint(await cm.get_messages_range(sid,0,count)) != expected:
+                        raise RuntimeError('memory_prefix_changed')
+                    pending = await cm.get_session_metadata(sid,'pending_summary',None)
+                    # Rotation owns bounded retry timing. Reopen a native range
+                    # paused after three failures, without clearing durable progress.
+                    if pending:
+                        pending = dict(pending,retry_count=0)
+                    plan = await reflection._build_reflection_window(event,sid,count,cursor,pending,revision)
+                    if plan is None or plan.start_index != cursor or not cursor < plan.end_index <= count:
+                        raise RuntimeError('memory_window_not_covering_boundary')
+                    if all(not str(m.content or '').strip() for m in plan.history_messages):
+                        # Empty input has an explicit durable no-new-memory result.
+                        ok = await cm.commit_summary_progress(sid,plan.end_index,revision)
+                        await cm.update_session_metadata_if_revision(sid,'rotation_empty_boundary_id',plan.history_messages[-1].id,revision)
+                    else:
+                        task = asyncio.create_task(reflection._storage_task(sid,plan.history_messages,
+                            plan.persona_id,plan.start_index,plan.end_index,0,
+                            memory_scope=plan.memory_scope,expected_revision=revision,
+                            triggered_by='session_rotation'))
+                        owner._storage_tasks.add(task)
+                        owner._storage_session_tasks[sid] = task
+                        task.add_done_callback(lambda t, source=sid: reflection._on_storage_task_done(t,source))
+                        ok = await asyncio.shield(task)
+                    advanced = int(await cm.get_session_metadata(sid,'last_summarized_index',0) or 0)
+                    if not ok or advanced <= cursor:
+                        raise RuntimeError('memory_window_not_committed')
+                finally:
+                    if task is None:
+                        owner._storage_sessions_inflight.discard(sid)
+            if fingerprint(await cm.get_messages_range(sid,0,count)) != expected:
+                raise RuntimeError('memory_boundary_changed')
+            pending = await cm.get_session_metadata(sid,'pending_summary',None)
+            if pending and int(pending.get('start_index',0)) < count:
+                raise RuntimeError('memory_pending_before_boundary')
+            receipt = dict(boundary_id=prefix[-1].id if prefix else None,
+                boundary_count=count,prefix_sha256=expected,
+                cursor=int(await cm.get_session_metadata(sid,'last_summarized_index',0) or 0))
+            if not await cm.update_session_metadata_if_revision(sid,'rotation_receipt',receipt,revision):
+                raise RuntimeError('memory_receipt_revision_changed')
+            # Read the durable store, not an in-memory task completion flag.
+            session = await cm.store.get_session(sid)
+            if not session or session.metadata.get('rotation_receipt') != receipt:
+                raise RuntimeError('memory_receipt_not_durable')
+            receipts.append(dict(source=hashlib.sha256(sid.encode()).hexdigest(),**receipt))
+        return dict(complete=True,streams=receipts)
+    finally:
+        pins.difference_update(sessions)
