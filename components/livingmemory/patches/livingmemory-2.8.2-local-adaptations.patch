+@pytest.mark.asyncio
+async def test_four_distinct_sources_overlap_without_duplicate_cursor_commits(system):
+    cfg,cm,engine,processor,h,bg=system
+    events=[await seed(h,user=str(i),group=str(i)) for i in range(5)]
+    sources={resolve_capture_session(cfg,e) for e in events}
+    release=asyncio.Event();all_started=asyncio.Event();active=peak=0
+    async def summarize(messages,**kwargs):
+        nonlocal active,peak
+        active+=1;peak=max(peak,active)
+        if active==4:all_started.set()
+        try:
+            await release.wait()
+            return 'summary',{'topics':['test']},0.7
+        finally:active-=1
+    processor.process_conversation.side_effect=summarize
+    with patch('astrbot_plugin_livingmemory.core.event_handler_modules.memory_reflection.get_persona_id',new=AsyncMock(return_value=None)):
