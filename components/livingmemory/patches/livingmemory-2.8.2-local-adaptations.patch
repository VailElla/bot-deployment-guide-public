+import json,time
+from unittest.mock import AsyncMock
+import pytest
+from astrbot_plugin_livingmemory.core.processors.topic_batch import parse_segments
+from astrbot_plugin_livingmemory.core.processors.memory_processor import MemoryProcessor
+from astrbot_plugin_livingmemory.core.models.conversation_models import Message
+
+def data(facts):return json.dumps({'processed_messages':1,'segments':[{'start':0,'end':1,'summary':'我记得这次只是互相问候，没有确认的新偏好或计划。','key_facts':facts,'topics':['问候'],'importance':0.1}]},ensure_ascii=False)
+
+def test_no_claims_are_valid_but_malformed_claims_still_fail():
+ assert parse_segments(data([]),1,24,20)[0]['key_facts']==[]
+ for invalid in [[''],[None],['fact']*21,None,'']:
+  with pytest.raises(ValueError):parse_segments(data(invalid),1,24,20)
+
+@pytest.mark.asyncio
+async def test_empty_facts_do_not_become_invented_user_claims():
+ p=MemoryProcessor(config={'summary_max_key_facts':20,'attribution_guard_enabled':True})
+ p._call_llm_with_retry=AsyncMock(return_value=data([]))
+ messages=[Message(id=1,session_id='test',role='user',content='你好',sender_id='a',sender_name='甲',timestamp=time.time())]
+ result=await p.process_topic_batch(messages)
+ assert len(result)==1 and result[0]['metadata']['key_facts']==[]
+ assert p._call_llm_with_retry.await_count==1
