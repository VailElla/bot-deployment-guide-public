+import json
+import time
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from tests.test_background_summary import system, seed
+from astrbot_plugin_livingmemory.core.content_batching import bounded_prefix, select_window, window_tokens
+from astrbot_plugin_livingmemory.core.base.config_manager import ConfigManager
+from astrbot_plugin_livingmemory.core.memory_scope import resolve_capture_session
+from astrbot_plugin_livingmemory.core.processors.memory_processor import MemoryProcessor
+
+PERSONA = 'astrbot_plugin_livingmemory.core.event_handler_modules.memory_reflection.get_persona_id'
+
+
+def config(**kw):
+    return ConfigManager({'background_summary': {'content_batching': True, **kw}})
+
+
+def messages(n, text='旅行计划和住宿安排。'*60):
+    return [SimpleNamespace(role='user', content=text, sender_name='甲', sender_id='a',
+                            timestamp=time.time()+i) for i in range(n)]
+
+
+def enable(cfg, **kw):
+    cfg._config['background_summary'].update(content_batching=True, adaptive=True,
+        max_messages_per_job=1000, quiet_seconds=180, idle_seconds=1800, max_wait_seconds=7200, **kw)
+
+
+def test_larger_window_stops_at_whole_message_token_budget():
+    data=messages(100)
+    cfg=config()
+    end=bounded_prefix(data,cfg)
+    assert 1 < end < len(data)
+    assert window_tokens(data[:end]) <= 24576
+    assert window_tokens(data[:end+1]) > 24576
+    assert data[end-1].content.endswith('安排。')
+
+
+def test_oversized_single_message_is_never_truncated_or_skipped():
+    data=messages(2,'重要长文。'*10000)
+    assert bounded_prefix(data,config()) == 1
+    assert len(data[0].content) == 50000
+
+
+@pytest.mark.asyncio
+async def test_substantial_segment_is_closed_at_a_real_pause():
+    data=messages(8)
+    for m in data[4:]:m.timestamp += 600
+    end,reason=await select_window(data,config())
+    assert (end,reason)==(4,'time_gap')
+
+
+@pytest.mark.asyncio
+async def test_semantic_split_requires_coherent_topics_on_both_sides():
+    data=messages(8)
+    provider=SimpleNamespace(get_embeddings=AsyncMock(return_value=[[1.,0.]]*4+[[0.,1.]]*4))
+    end,reason=await select_window(data,config(),provider)
+    assert (end,reason)==(4,'semantic_shift')
+    assert len(provider.get_embeddings.await_args_list[0].args[0])==8
+    assert all(len(t)<=321 for t in provider.get_embeddings.await_args_list[0].args[0])
+
+
+@pytest.mark.asyncio
+async def test_one_off_topic_does_not_split_an_otherwise_coherent_discussion():
+    data=messages(8)
+    vectors=[[1.,0.]]*3+[[0.,1.]]+[[1.,0.]]*4
+    provider=SimpleNamespace(get_embeddings=AsyncMock(return_value=vectors))
+    assert await select_window(data,config(),provider)==(8,'available_context')
+
+
+@pytest.mark.asyncio
+async def test_embedding_failure_falls_back_without_losing_source_messages():
+    data=messages(8)
+    provider=SimpleNamespace(get_embeddings=AsyncMock(side_effect=RuntimeError('temporary')))
+    assert await select_window(data,config(),provider)==(8,'available_context')
+    assert len(data)==8
+
+
+@pytest.mark.asyncio
+async def test_forty_short_messages_no_longer_force_an_immediate_summary(system):
+    cfg,cm,engine,processor,h,bg=system
+    enable(cfg)
+    event=await seed(h,n=40)
+    sid=resolve_capture_session(cfg,event)
+    assert await bg.candidates({sid})==[]
+    assert bg.next_due_at>time.time()+1700
+    processor.process_conversation.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_more_than_one_hundred_messages_are_summarized_together(system):
+    cfg,cm,engine,processor,h,bg=system
+    enable(cfg,batch_semantic_split=False)
+    event=await seed(h,n=180)
+    sid=resolve_capture_session(cfg,event)
+    await cm.store.connection.execute('UPDATE sessions SET last_active_at=? WHERE session_id=?',(time.time()-1801,sid))
+    await cm.store.connection.commit()
+    with patch(PERSONA,new=AsyncMock(return_value=None)):
+        await bg.run_once({sid})
+    assert bg.metrics['completed']==1
+    assert len(processor.process_conversation.await_args.kwargs['messages'])==180
+    assert await cm.get_session_metadata(sid,'last_summarized_index',0)==180
+    record=next(iter(engine.docs.values()))['metadata']['source_window']
+    assert record['message_count']==180 and record['batching_policy']=='token_topic_v1'
+
+
+@pytest.mark.asyncio
+async def test_five_round_foreground_does_not_bypass_content_scheduler(system):
+    cfg,cm,engine,processor,h,bg=system
+    enable(cfg)
+    cfg._config['reflection_engine']['summary_trigger_rounds']=5
+    h.group_memory.config._config['background_summary'].update(cfg._config['background_summary'])
+    event=await seed(h,n=24)
+    response=SimpleNamespace(role='assistant',completion_text='我记下了。',tools_call_name=None,tools_call_extra_content=None)
+    await h.handle_memory_reflection(event,response)
+    await bg.run_once({resolve_capture_session(cfg,event)})
+    assert not h._storage_tasks and not engine.docs
+    processor.process_conversation.assert_not_awaited()
+    assert bg.wake.is_set()
+
+
+@pytest.mark.asyncio
+async def test_failed_retry_keeps_original_window_instead_of_absorbing_new_messages(system):
+    cfg,cm,engine,processor,h,bg=system
+    enable(cfg,batch_semantic_split=False)
+    event=await seed(h,n=20)
+    sid=resolve_capture_session(cfg,event)
+    reflection=h._memory_reflection
+    plan=await reflection._build_reflection_plan_for_cursor(sid,20,0,
+        {'start_index':0,'end_index':8,'retry_count':1},None,None,'test-scope')
+    assert plan.start_index==0 and plan.end_index==8 and len(plan.history_messages)==8
+
+
+@pytest.mark.asyncio
+async def test_token_mode_still_discards_a_reset_during_summary(system):
+    cfg,cm,engine,processor,h,bg=system
+    enable(cfg,batch_semantic_split=False)
+    event=await seed(h,n=180)
+    sid=resolve_capture_session(cfg,event)
+    await cm.store.connection.execute('UPDATE sessions SET last_active_at=? WHERE session_id=?',(time.time()-1801,sid))
+    await cm.store.connection.commit()
+    import asyncio
+    started=asyncio.Event();release=asyncio.Event()
+    async def wait_summary(**kwargs):
+        started.set();await release.wait();return 'summary',{'topics':['test']},0.7
+    processor.process_conversation.side_effect=wait_summary
+    with patch(PERSONA,new=AsyncMock(return_value=None)):
+        task=asyncio.create_task(bg.run_once({sid}));await asyncio.wait_for(started.wait(),3)
